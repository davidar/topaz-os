#!/bin/bash
# topaz — the topaz-os system companion.
#
#   topaz why <path>     Why does this file deviate from the base image?
#   topaz ledger         List all recorded deviations
#   topaz check          Verify the image's recorded deviations actually hold
#   topaz dev ...        Transient /usr overlay for locally built binaries
#   topaz pull [image]   Fetch a big update in parallel and stage it for reboot
set -euo pipefail

LEDGER_DIR="${TOPAZ_LEDGER_DIR:-/usr/share/topaz-os/ledger}"
DEV_MANIFEST=/run/topaz-dev/manifest

usage() {
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

strip_frontmatter() {
    awk 'BEGIN{fm=0} /^---$/{fm++; next} fm!=1{print}' "$1"
}

entry_title() {
    awk '/^title:/{sub(/^title: */, ""); print; exit}' "$1"
}

cmd_ledger() {
    local f
    for f in "$LEDGER_DIR"/*.md; do
        [ -e "$f" ] || { echo "No ledger entries found in $LEDGER_DIR"; exit 1; }
        printf '%s  %s\n' "$(basename "$f" .md)" "$(entry_title "$f")"
    done
}

cmd_why() {
    local query="${1%/}" f found=0
    for f in "$LEDGER_DIR"/*.md; do
        [ -e "$f" ] || break
        if awk -v q="$query" '
            BEGIN{fm=0; hit=1}
            /^---$/{fm++; next}
            fm==1 && /^  - /{sub(/^  - /,""); if ($0==q) {hit=0; exit}}
            END{exit hit}
            ' "$f"; then
            found=1
            strip_frontmatter "$f"
            echo
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "No ledger entry covers '$query'."
        echo "It likely comes from the base image (see: https://docs.projectbluefin.io/)"
        echo "or was changed locally on this machine outside the image."
        exit 1
    fi
}

# --- checks: each recorded deviation must actually hold on this system ------

fails=0
chk() { # chk <description> <command...>
    local desc="$1"; shift
    if "$@" >/dev/null 2>&1; then
        printf '[ ok ] %s\n' "$desc"
    else
        printf '[FAIL] %s\n' "$desc"
        fails=$((fails + 1))
    fi
}

cmd_check() {
    chk "MGLRU anti-thrash threshold ships (kill fast instead of thrashing)" \
        grep -q 'min_ttl_ms - - - - 1000' /usr/lib/tmpfiles.d/topaz-mglru.conf
    chk "SysRq is fully enabled (manual OOM kill escape hatch)" \
        grep -qx 'kernel.sysrq = 1' /usr/lib/sysctl.d/99-topaz-sysrq.conf
    chk "systemd-oomd acts on 5s of sustained pressure" \
        grep -qx 'DefaultMemoryPressureDurationSec=5s' \
            /usr/lib/systemd/oomd.conf.d/topaz.conf
    chk "GTK4 GL renderer default is present" \
        grep -qx 'GSK_RENDERER=gl' /usr/lib/environment.d/50-gsk-renderer.conf
    chk "Goodix fingerprint TOD driver is installed" \
        rpm -q libfprint-tod-goodix
    chk "os-release identifies the image as topaz-os" \
        bash -c 'grep -q "^NAME=\"topaz-os\"" /usr/lib/os-release &&
                 grep -q "^PRETTY_NAME=\"topaz-os " /usr/lib/os-release'
    chk "COSMIC session is available" \
        test -f /usr/share/wayland-sessions/cosmic.desktop
    chk "cosmic-comp is the topaz fork build" \
        bash -c 'test -f /usr/share/topaz-os/cosmic-comp-fork &&
                 rpm -Vf /usr/bin/cosmic-comp | grep cosmic-comp | grep -q 5'
    chk "packaged cosmic-comp still matches the fork base version" \
        bash -c '[ "$(rpm -q --qf %{VERSION} cosmic-comp)" = \
                   "$(sed -n "s/^base=//p" /usr/share/topaz-os/cosmic-comp-fork)" ]'
    chk "fork cosmic-comp is loadable (builder glibc matches the image)" \
        bash -c '! ldd /usr/bin/cosmic-comp | grep -q "not found"'
    chk "GDM remains the display manager" \
        bash -c '[ "$(basename "$(readlink /etc/systemd/system/display-manager.service)")" = gdm.service ]'
    chk "no unprivileged DDC/CI i2c access (COSMIC freeze mitigation)" \
        bash -c '! grep -h i2c /usr/lib/udev/rules.d/*.rules | grep -v "^#" | grep -q uaccess'
    chk "eDP Panel Self Refresh is disabled (DMUB wedge mitigation)" \
        grep -q 'amdgpu.dcdebugmask=0x10' /usr/lib/bootc/kargs.d/10-topaz-display.toml
    chk "fingerprint PAM timeout is 5s" \
        grep -q 'pam_fprintd.so timeout=5' /etc/pam.d/system-auth
    chk "cosmic-greeter may verify fingerprints (lock-screen polkit rule)" \
        bash -c 'grep -q "net.reactivated.fprint.device.verify" \
                     /usr/share/polkit-1/rules.d/60-topaz-cosmic-greeter-fprintd.rules &&
                 grep -q "/usr/bin/cosmic-greeter" \
                     /usr/share/polkit-1/rules.d/60-topaz-cosmic-greeter-fprintd.rules'
    chk "authselect profile symlinks to the base profile" \
        test -L /etc/authselect/custom/local-custom/password-auth
    chk "authselect state file records the custom profile" \
        bash -c '[ "$(cat /etc/authselect/authselect.conf)" = "$(printf \
            "custom/local-custom\nwith-fingerprint\nwith-silent-lastlog\nwith-mdns4")" ]'
    chk "Playwright Chrome path rule is present" \
        test -f /usr/lib/tmpfiles.d/topaz-chrome-path.conf
    chk "supergfxd is enabled" \
        bash -c 'ls /etc/systemd/system/*.wants/supergfxd.service >/dev/null 2>&1'
    chk "speech-dispatcher user preset is present" \
        grep -q 'enable speech-dispatcher.socket' /usr/lib/systemd/user-preset/45-topaz.preset
    chk "topaz-home bootstrap recipe is present" \
        bash -c 'test -f /usr/share/ublue-os/just/60-custom.just &&
                 grep -q "^topaz-home" \
                     /usr/share/ublue-os/just/60-custom.just'
    # the zone dir is root-only readable, so unprivileged runs (nightshift)
    # skip the grep; the build gate runs as root and asserts it
    chk "KDE Connect firewall ports are open (ledger 0030)" \
        bash -c '[ ! -r /etc/firewalld/zones/FedoraWorkstation.xml ] ||
                 grep -q "service name=\"kdeconnect\"" \
                     /etc/firewalld/zones/FedoraWorkstation.xml'
    chk "ledger entries are well-formed" \
        bash -c 'for f in "'"$LEDGER_DIR"'"/*.md; do
                     grep -q "^title:" "$f" && grep -q "^paths:" "$f" || exit 1
                 done'
    chk "bootc is available for dev overlays" \
        command -v bootc
    chk "podman, jq and skopeo are present for parallel pulls (topaz pull)" \
        bash -c 'command -v podman && command -v jq && command -v skopeo'
    chk "partial image pulls are enabled in containers-storage (ledger 0031)" \
        grep -qx 'enable_partial_images = "true"' /usr/share/containers/storage.conf
    chk "topaz-pull.timer stages updates ahead of uupd (ledger 0032)" \
        bash -c 'ls /etc/systemd/system/timers.target.wants/topaz-pull.timer >/dev/null 2>&1'
    chk "package install metadata is reproducible" \
        bash -c 'sde=$(cat /usr/share/topaz-os/source-date-epoch) &&
                 for p in cosmic-session nethogs; do
                     t=$(rpm -q --qf "%{INSTALLTIME}" "$p")
                     [ $((t - sde)) -ge 0 ] && [ $((t - sde)) -lt 1000 ] || exit 1
                 done'
    chk "rpm database is readable from read-only /usr (DELETE journal mode)" \
        bash -c '[ "$(od -A n -j 18 -N 2 -t u1 /usr/share/rpm/rpmdb.sqlite |
                      tr -s " ")" = " 1 1" ]'
    chk "no build-time authselect backup is baked into the image" \
        bash -c '! ls /usr/lib/authselect/backups/ 2>/dev/null | grep -q .'
    chk "XML catalogs are intact (well-formed XML)" \
        bash -c 'xmllint --noout /etc/xml/catalog &&
                 xmllint --noout /etc/sgml/docbook/xmlcatalog'
    chk "SELinux module store is committed cleanly" \
        bash -c '! test -e /etc/selinux/targeted/previous &&
                 ! test -e /etc/selinux/targeted/tmp &&
                 ! test -e /etc/selinux/final/targeted &&
                 test -d /etc/selinux/targeted/active/modules/200/greetd'
    chk "no leftover build-mount debris in the image root" \
        bash -c '! test -e /ctx'
    # the files exist only while some dependency pulls docbook-dtds
    # (none does since the kde-connect subtree left); absent is canonical
    chk "sgml catalogs are in canonical order" \
        bash -c 'for f in /etc/sgml/catalog /etc/sgml/*.cat; do
                     [ -e "$f" ] || continue
                     [ -L "$f" ] && continue
                     LC_ALL=C sort -C "$f" || exit 1
                 done'
    chk "installed package set matches the shipped lockfile" \
        bash -c 'lock=/usr/share/topaz-os/packages.lock
                 rpm -q $(sed -n "s/^+//p" "$lock" | cut -d" " -f1) \
                     > /dev/null || exit 1
                 sed -n "s/^-//p" "$lock" | cut -d" " -f1 \
                     | xargs -r -n1 rpm -q 2>/dev/null \
                     | grep -qv "is not installed" && exit 1; true'
    chk "trimmed app-suite packages are absent (ledger 0025)" \
        bash -c '! rpm -q cosmic-initial-setup > /dev/null 2>&1 &&
                 ! rpm -q cosmic-wallpapers > /dev/null 2>&1'
    chk "plugdev group is declared for base-image udev rules" \
        grep -q '^g plugdev' /usr/lib/sysusers.d/topaz-plugdev.conf
    chk "nethogs holds packet-capture file capabilities" \
        bash -c '[ "$(getcap /usr/sbin/nethogs)" = \
            "/usr/sbin/nethogs cap_dac_read_search,cap_net_admin,cap_net_raw,cap_sys_ptrace=ep" ]'
    chk "greeter portal mask ships declaratively (tmpfiles.d, not /var content)" \
        grep -q 'xdg-desktop-portal.service - - - - /dev/null' \
            /usr/lib/tmpfiles.d/topaz-greetd-portal-mask.conf
    # Build-container only: a booted machine's /var is legitimate machine
    # state; the image must ship none (only an empty /var/tmp, matching
    # the base — build debris there churns rebuilds, see ledger 0024).
    if [ ! -e /run/ostree-booted ]; then
        # List offenders before the verdict — chk swallows command output,
        # and a bare FAIL from a remote build log is undebuggable.
        local stray
        stray="$(find /var -mindepth 1 -not -path /var/tmp)"
        [ -z "$stray" ] || printf 'stray /var content:\n%s\n' "$stray"
        chk "image ships an empty /var" test -z "$stray"
    fi
    if overlay_active; then
        echo
        echo "[DEV ] A transient /usr overlay is ACTIVE — this system currently"
        echo "[DEV ] deviates from the signed image. 'topaz dev status' lists the"
        echo "[DEV ] installed binaries; a reboot returns to the image."
    fi
    echo
    if [ "$fails" -eq 0 ]; then
        echo "All recorded deviations hold."
    else
        echo "$fails check(s) failed — the image no longer matches its ledger."
        exit 1
    fi
}

# --- dev: transient /usr overlay for daily-driving locally built binaries ---
# The image is the signed trunk; experiments live in a bootc usroverlay that
# a reboot fully discards. Installed files are recorded in a tmpfs manifest
# so the deviation is always visible (topaz dev status, topaz check).

overlay_active() {
    findmnt -n /usr >/dev/null 2>&1
}

cmd_dev() {
    case "${1:-status}" in
    on)
        if overlay_active; then
            echo "Transient /usr overlay is already active."
        else
            echo "Arming a transient overlay on /usr (bootc usroverlay)."
            echo "Changes under /usr persist until reboot, then vanish."
            pkexec bootc usroverlay
        fi
        ;;
    install)
        [ $# -ge 2 ] || { echo "Usage: topaz dev install <file> [dest]"; exit 1; }
        local src dest sum
        src=$(realpath "$2")
        dest="${3:-/usr/bin/$(basename "$src")}"
        [ -f "$src" ] || { echo "No such file: $src"; exit 1; }
        overlay_active || { echo "No overlay active — run 'topaz dev on' first."; exit 1; }
        sum=$(sha256sum "$src" | cut -d' ' -f1)
        pkexec bash -c "install -m0755 '$src' '$dest' &&
                        mkdir -p /run/topaz-dev &&
                        printf '%s\t%s\t%s\t%s\n' '$dest' '$sum' '$src' \"\$(date -Is)\" \
                            >> $DEV_MANIFEST"
        echo "Installed $dest (sha256 ${sum:0:12}…, gone after reboot)."
        if pgrep -x "$(basename "$dest")" >/dev/null 2>&1; then
            echo "Note: $(basename "$dest") is currently running the old binary;"
            echo "restart it (or the session) to pick up the new one."
        fi
        ;;
    status)
        if overlay_active; then
            echo "Transient /usr overlay: ACTIVE (reboot returns to the signed image)"
            if [ -s "$DEV_MANIFEST" ]; then
                echo "Installed dev binaries:"
                awk -F'\t' '{printf "  %s  %.12s…  from %s  (%s)\n", $1, $2, $3, $4}' \
                    "$DEV_MANIFEST"
            else
                echo "No dev binaries recorded (manifest empty)."
            fi
        else
            echo "Transient /usr overlay: not active — /usr matches the signed image."
        fi
        ;;
    off)
        if overlay_active; then
            echo "The overlay is transient: reboot to return to the signed image."
        else
            echo "No overlay active."
        fi
        ;;
    *)
        echo "Usage: topaz dev [on|install <file> [dest]|status|off]"
        exit 1
        ;;
    esac
}

# --- pull: parallel-fetch big updates, then stage them via bootc ------------
# bootc downloads layers serially through its image proxy (bootc#20), which
# wastes most of a fast link — and content-based layers (ledger 0028) add a
# round trip per layer. podman downloads layers in parallel. For big pulls
# (tag switches, the first fetch after a layer-scheme change — not small
# incremental updates, where serial is fine) this fetches with podman into
# root's containers-storage, imports locally, repoints the origin back at
# the registry so automatic updates keep tracking it (a no-op fetch: every
# layer is already imported), and drops the podman copy. Disk usage doubles
# while the image transiently exists in both stores.

cmd_pull() {
    [ "$(id -u)" -eq 0 ] || {
        echo "topaz pull needs root (try: pkexec topaz pull)"
        exit 1
    }
    local image="${1:-}" spec
    spec=$(bootc status --format json)
    if [ -z "$image" ]; then
        local transport
        transport=$(jq -r '.spec.image.transport' <<<"$spec")
        [ "$transport" = registry ] || {
            echo "Origin transport is '$transport', not a registry —"
            echo "pass the image to fetch explicitly: topaz pull <registry-ref>"
            exit 1
        }
        image=$(jq -r '.spec.image.image' <<<"$spec")
    fi
    # No-op when the registry holds nothing new: safe to run from a timer,
    # and skips a redundant restage on manual re-runs. Only when pulling
    # the current origin — an explicit different reference is a deliberate
    # switch and must always reach bootc, even if the content is already
    # present (e.g. repointing the origin back at the registry).
    local remote
    if [ "$image" = "$(jq -r '.spec.image.image // empty' <<<"$spec")" ]; then
        remote="sha256:$(skopeo inspect --no-tags --raw "docker://$image" \
            | sha256sum | cut -d' ' -f1)"
        if [ "$remote" = "$(jq -r '.status.staged.image.imageDigest // empty' <<<"$spec")" ] \
            || [ "$remote" = "$(jq -r '.status.booted.image.imageDigest // empty' <<<"$spec")" ]; then
            echo "Already up to date ($remote staged or booted)."
            exit 0
        fi
    fi
    echo "Fetching $image with parallel layer downloads…"
    local old_id new_id
    old_id=$(podman image inspect --format '{{.Id}}' "$image" 2>/dev/null || true)
    podman pull "$image"
    new_id=$(podman image inspect --format '{{.Id}}' "$image")
    echo "Importing into bootc from local container storage…"
    bootc switch --transport containers-storage "$image"
    echo "Repointing the origin at the registry (all layers already imported)…"
    bootc switch "$image"
    # The fresh podman copy stays: it is the delta base for the next
    # partial pull (ledger 0031) — worth its ~5 GiB standing cost in /var.
    # Only the copy it supersedes is reclaimed.
    if [ -n "$old_id" ] && [ "$old_id" != "$new_id" ]; then
        echo "Reclaiming the superseded delta base…"
        podman rmi "$old_id" > /dev/null \
            || echo "note: could not remove superseded image $old_id (extra tags?)"
    fi
    echo
    echo "Staged. Reboot cleanly to activate — a power cut discards staged"
    echo "deployments."
}

case "${1:-}" in
    why)        [ $# -ge 2 ] || usage 1; cmd_why "$2" ;;
    ledger)     cmd_ledger ;;
    check)      cmd_check ;;
    dev)        shift; cmd_dev "$@" ;;
    pull)       shift; cmd_pull "$@" ;;
    -h|--help|"") usage ;;
    *) usage 1 ;;
esac
