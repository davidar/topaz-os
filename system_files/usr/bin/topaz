#!/bin/bash
# topaz — the topaz-os system companion.
#
#   topaz check          Verify every deliberate deviation from the base image holds
#   topaz dev ...        Transient /usr overlay for locally built binaries
#   topaz pull [image]   Fetch a big update in parallel and stage it for reboot
#   topaz boot-order [fix]  Show the firmware's boot order; put this system first
#
# cmd_check is also the record of what this image changes and why: each
# check asserts one deliberate deviation from the base image, and the
# comment above it says what the deviation is for. A change that can be
# verified at build time adds its check here, with its reason.
set -euo pipefail

DEV_MANIFEST=/run/topaz-dev/manifest

usage() {
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# --- checks: each deviation must actually hold on this system ---------------

fails=0
chk() { # chk <description> <command...>
    local desc="$1"; shift
    if "$@" >/dev/null 2>&1; then
        printf '[ ok ] %s\n' "$desc"
    else
        printf '[FAIL] %s\n' "$desc"
        fails=$((fails + 1))
    fi
}

cmd_check() {
    # Kernel releases with a known regression on this hardware are refused:
    # the pattern is the denylist. The weekly input refresh goes red
    # instead of shipping such a kernel, and on a booted machine a failure
    # means the running kernel is one this image would refuse.
    #   7.1.6, 7.1.7: amdgpu scanout corruption on the Radeon 780M (blocks
    #   of noise during large redraws; Red Hat bug 2512106), fixed in
    #   7.1.8. Drop the pattern once no base can carry them.
    # The base follows Bluefin's `latest` (Fedora's own kernel), not
    # `stable`: the CoreOS soak behind `stable` catches server regressions,
    # not desktop-GPU ones, and it delayed that fix by two weeks.
    chk "kernel is not a known-bad release: 7.1.6/7.1.7 amdgpu scanout corruption" \
        bash -c '! rpm -q kernel --qf "%{VERSION}-%{RELEASE}\n" | grep -qE "^7\.1\.[67]-"'
    # Memory exhaustion resolves in about a second instead of thrashing for
    # a minute. MGLRU min_ttl_ms=1000: the kernel OOM-kills the top
    # consumer rather than evict a working set younger than a second
    # (ChromeOS's value; mainline leaves it off). SysRq: Alt+PrtSc+F is a
    # manual kernel-level kill that works with userspace frozen.
    # systemd-oomd acts on 5 s of pressure, not 20. earlyoom was removed:
    # it watches MemAvailable, which stays high through a thrash spiral.
    chk "MGLRU anti-thrash threshold ships (kill fast instead of thrashing)" \
        grep -q 'min_ttl_ms - - - - 1000' /usr/lib/tmpfiles.d/topaz-mglru.conf
    chk "SysRq is fully enabled (manual OOM kill escape hatch)" \
        grep -qx 'kernel.sysrq = 1' /usr/lib/sysctl.d/99-topaz-sysrq.conf
    chk "systemd-oomd acts on 5s of sustained pressure" \
        grep -qx 'DefaultMemoryPressureDurationSec=5s' \
            /usr/lib/systemd/oomd.conf.d/topaz.conf
    # Swap is zswap (zstd, LRU shrinker) over a disk swapfile created on
    # first boot, not Fedora's zram. A zram pool is RAM: cold pages never
    # leave memory, and once the pool is full the OOM killer is the only
    # release valve. The comment-only zram-generator.conf overrides the
    # packaged default and defines no device (zram under zswap would
    # compress every page twice). Post-boot: `swapon --show` lists
    # /var/swap/swapfile and no zram device.
    chk "no zram device: the generator config defines none" \
        bash -c 'test -f /etc/systemd/zram-generator.conf &&
                 ! grep -q "^\[" /etc/systemd/zram-generator.conf'
    chk "zswap is enabled with zstd and the LRU shrinker" \
        bash -c 'f=/usr/lib/tmpfiles.d/topaz-zswap.conf &&
                 grep -q "parameters/compressor - - - - zstd" "$f" &&
                 grep -q "parameters/shrinker_enabled - - - - Y" "$f" &&
                 grep -q "parameters/enabled - - - - Y" "$f"'
    chk "disk swapfile unit is enabled and its creator is executable" \
        bash -c 'ls /etc/systemd/system/swap.target.wants/var-swap-swapfile.swap >/dev/null 2>&1 &&
                 test -x /usr/libexec/topaz/swapfile'
    # GTK4's Vulkan renderer enumerates Vulkan devices at startup, and the
    # NVIDIA driver powers a suspended dGPU on to answer: about 2 s added
    # to every GTK4 app launch on a hybrid laptop. The GL renderer does not
    # enumerate. Revisit if NVIDIA ships enumeration without the wake-up.
    chk "GTK4 GL renderer default is present" \
        grep -qx 'GSK_RENDERER=gl' /usr/lib/environment.d/50-gsk-renderer.conf
    # The Goodix 27c6:550a fingerprint sensor has no driver in upstream
    # libfprint; libfprint-tod and the Goodix TOD driver (a pinned-version
    # COPR) replace it.
    chk "Goodix fingerprint TOD driver is installed" \
        rpm -q libfprint-tod-goodix
    # GRUB titles boot entries with os-release's PRETTY_NAME; inherited
    # verbatim, this image and its Bluefin rollback were identical lines in
    # the boot menu. Only NAME and PRETTY_NAME change: ID and the rest stay
    # Bluefin's, so Universal Blue tooling keeps treating it as a
    # derivative.
    chk "os-release identifies the image as topaz-os" \
        bash -c 'grep -q "^NAME=\"topaz-os\"" /usr/lib/os-release &&
                 grep -q "^PRETTY_NAME=\"topaz-os " /usr/lib/os-release'
    # No COSMIC session or shell and no fork-built COSMIC binary. The daily
    # session runs none of them, and the four forks the COSMIC sessions
    # needed (cosmic-comp with smithay, greeter, applets, idle) cost a
    # rebase at every Fedora COSMIC release. The packages the image once
    # forked are absent, and so is everything that existed only for the
    # sessions they served. The applications stay as ordinary packages
    # (files, settings and the launcher stand for them here); GNOME is the
    # fallback session.
    chk "no COSMIC session, shell or fork remains" \
        bash -c 'for p in cosmic-session cosmic-comp cosmic-greeter cosmic-applets \
                          cosmic-idle cosmic-panel cosmic-bg cosmic-notifications \
                          cosmic-initial-setup cosmic-wallpapers; do
                     rpm -q $p > /dev/null 2>&1 && exit 1
                 done
                 ! test -e /usr/share/wayland-sessions/cosmic.desktop &&
                 ! test -e /usr/share/wayland-sessions/cosmic-niri.desktop &&
                 ! test -e /usr/share/topaz-os/cosmic-comp-fork &&
                 ! test -e /usr/share/topaz-os/cosmic-greeter-fork &&
                 ! test -e /usr/bin/cosmic-ext-alternative-startup &&
                 ! test -e /usr/bin/start-cosmic-niri &&
                 ! test -e /etc/niri/cosmic-shell.kdl &&
                 ! test -e /usr/libexec/topaz/cosmic-shim &&
                 ! test -e /usr/lib/systemd/user/topaz-session-shutdown.target &&
                 ! test -e /usr/share/polkit-1/rules.d/60-topaz-cosmic-greeter-fprintd.rules &&
                 ! rpm -q xdg-desktop-portal-cosmic > /dev/null 2>&1 &&
                 ! rpm -q cosmic-screenshot > /dev/null 2>&1 &&
                 for p in cosmic-files cosmic-settings cosmic-launcher; do
                     rpm -q $p > /dev/null 2>&1 || exit 1
                 done'
    # /usr/bin/niri is built from the topaz fork (github.com/davidar/niri)
    # at a pinned commit on the release Fedora packages; the rest of the
    # niri package is unchanged. The fork turns 28 compile-time constants
    # (swipe distances, finger counts, thresholds) into config keys, masks
    # background blur by the surface's own alpha, keeps a lock in flight
    # across a skipped frame (a suspend otherwise resumed unlocked),
    # reports a spawn that fails to exec instead of deadlocking, and adds
    # the ext-image-copy-capture protocols and a has-sibling window
    # matcher. The build fails when Fedora's niri moves past the fork's
    # base (rebase, then move NIRI_REF), and the builder's Fedora release
    # must match the image's or the binary fails to load (glibc): hence
    # the version and library assertions.
    chk "niri is the topaz build: tunables, masked blur, trusted sandboxes" \
        bash -c 'test -f /usr/share/topaz-os/niri-session-build &&
                 rpm -Vf /usr/bin/niri | grep "/usr/bin/niri$" | grep -q 5 &&
                 [ "$(rpm -q --qf %{VERSION} niri)" = \
                   "$(sed -n "s/^niri_base=//p" /usr/share/topaz-os/niri-session-build)" ] &&
                 ! ldd /usr/bin/niri | grep -q "not found"'
    # The compilers are locked like the packages. An unpinned `dnf install`
    # in the builder stages let a cached stage ship a niri compiled by an
    # older rustc than a cold rebuild installs, and every Rust layer failed
    # the weekly reproducibility check. Each stage now installs exactly its
    # own lock (niri-build.lock, caustics-build.lock) and records the rustc
    # it got: that build is the one the shipped lock names, and the binary
    # carries the Fedora build stamp rustc embeds.
    chk "fork-built binaries carry their locked rustc" \
        bash -c 'info=/usr/share/topaz-os/niri-session-build
                 for pair in niri:/usr/bin/niri caustics:/usr/bin/caustics-bar; do
                     name=${pair%%:*}; bin=${pair#*:}
                     evr=$(sed -n "s/^${name}_rustc=//p" "$info")
                     [ -n "$evr" ] || exit 1
                     grep -q "^+rust-0:${evr}\.x86_64 " "/usr/share/topaz-os/${name}-build.lock" || exit 1
                     grep -aqF "(Fedora ${evr})" "$bin" || exit 1
                 done'
    # /etc/niri/config.kdl, the fallback for accounts without a config of
    # their own, is niri's default plus the session's binds and the fork's
    # keys at their upstream defaults, so the knobs are documented where
    # they are set. The lock bind goes through logind: the lock client is
    # resident and hears the signal.
    chk "baked niri config is valid and carries no COSMIC session plumbing" \
        bash -c '! grep -q "^include " /etc/niri/config.kdl &&
                 ! grep -q "alternative-startup\|import-environment\|cosmic-shim\|trust-sandbox-engine" /etc/niri/config.kdl &&
                 grep -q "touchpad-swipe" /etc/niri/config.kdl &&
                 grep -q "mask-threshold" /etc/niri/config.kdl &&
                 grep -q "spawn \"loginctl\" \"lock-session\"" /etc/niri/config.kdl &&
                 grep -q "has-sibling=true" /etc/niri/config.kdl &&
                 ! grep -q "spawn \"cosmic-greeter\"" /etc/niri/config.kdl &&
                 niri validate -c /etc/niri/config.kdl'
    # The niri (topaz) session: niri's own systemd session with the
    # caustics bar and canvas and toolkit-free tools (swayidle, fuzzel,
    # cliphist, topaz-osd) as user units wanted by
    # graphical-session.target, each gated on XDG_SESSION_DESKTOP=topaz so
    # the GNOME session is untouched. No COSMIC shell process runs in it:
    # the shell's pieces had accumulated forks and incidents for no gain
    # over tools every other niri setup uses. Brightness goes through
    # logind's SetBrightness (no brightnessctl, no udev rule). What the
    # bar and canvas replaced (swaylock, swaybg, cosmic-osd, chayang,
    # mako, wob and their units) must stay gone.
    chk "niri (topaz) session: entry, units, shims and packages are in place" \
        bash -c 'grep -q "^Exec=/usr/bin/niri-session$" /usr/share/wayland-sessions/topaz.desktop &&
                 grep -q "^DesktopNames=topaz$" /usr/share/wayland-sessions/topaz.desktop &&
                 ! test -e /usr/share/wayland-sessions/topaz-niri.desktop &&
                 test -x /usr/bin/niri-session &&
                 test -f /usr/lib/systemd/user/niri.service &&
                 for u in caustics-bar.service caustics-canvas.service topaz-idle.service \
                          topaz-background.service topaz-clipboard.service; do
                     test -f /usr/lib/systemd/user/$u || exit 1
                     grep -q "^ConditionEnvironment=XDG_SESSION_DESKTOP=topaz$" /usr/lib/systemd/user/$u || exit 1
                     test -L /etc/systemd/user/graphical-session.target.wants/$u || exit 1
                 done &&
                 for f in /usr/lib/systemd/user/topaz-locker.service /usr/lib/systemd/user/topaz-polkit-agent.service \
                          /usr/libexec/topaz/locker /etc/swaylock/config /etc/pam.d/swaylock; do
                     ! test -e $f || exit 1
                 done &&
                 i=$(/usr/libexec/topaz/idle --print | tr "\n" " ") &&
                 [[ "$i" == "swayidle -w before-sleep caustics-canvasctl lock --wait "* ]] &&
                 [[ "$i" != *topaz-locker* && "$i" != *" lock systemctl"* ]] &&
                 ! grep -q pam_fprintd /etc/pam.d/password-auth &&
                 ! test -e /usr/lib/systemd/user/topaz-notifications.service &&
                 ! command -v mako > /dev/null &&
                 ! test -e /usr/lib/systemd/user/topaz-osd.socket &&
                 ! test -e /usr/lib/systemd/user/topaz-osd.service &&
                 ! command -v wob > /dev/null &&
                 test -x /usr/bin/topaz-osd &&
                 ! { grep -hvE "^\s*(#|//)" /usr/bin/topaz-osd /etc/niri/config.kdl | grep -q brightnessctl; } &&
                 grep -q "login1.Session SetBrightness" /usr/bin/topaz-osd &&
                 for b in swayidle fuzzel cliphist wl-paste busctl; do
                     command -v $b > /dev/null || exit 1
                 done &&
                 for b in swaylock swaybg cosmic-osd chayang; do
                     ! command -v $b > /dev/null || exit 1
                 done &&
                 ! test -e /usr/share/xdg-desktop-portal/topaz-portals.conf &&
                 grep -q "spawn \"fuzzel\"" /etc/niri/config.kdl &&
                 grep -q "spawn \"topaz-osd\" \"volume\" \"up\"" /etc/niri/config.kdl'
    # swayidle's stages come from one knob file (~/.config/topaz/
    # session.conf: TOPAZ_IDLE_LOCK, _WARN, _BLANK, _SUSPEND; 0 switches a
    # stage off; the shipped example documents each). The canvas dims the
    # screen for the warning period before the lock. Input cancels the dim
    # and that lock; a canvas that cannot be asked locks anyway, so a
    # missing warning fails toward a locked screen, never an open one.
    chk "idle stages from one knob file, with the canvas's dim before the lock" \
        bash -c '! command -v chayang > /dev/null &&
                 ! grep -q chayang /usr/share/topaz-os/niri-session-build &&
                 test -x /usr/libexec/topaz/idle &&
                 grep -q "^EnvironmentFile=-%h/.config/topaz/session.conf$" /usr/lib/systemd/user/topaz-idle.service &&
                 grep -q "^ExecStart=/usr/libexec/topaz/idle$" /usr/lib/systemd/user/topaz-idle.service &&
                 grep -q "^After=graphical-session.target caustics-canvas.service$" /usr/lib/systemd/user/topaz-idle.service &&
                 test -f /usr/share/topaz-os/session.conf &&
                 for k in $(grep -o "TOPAZ_IDLE_[A-Z]*" /usr/libexec/topaz/idle | sort -u); do
                     grep -q "^#$k=[0-9]" /usr/share/topaz-os/session.conf || exit 1
                 done &&
                 d=$(/usr/libexec/topaz/idle --print | tr "\n" " ") &&
                 [[ "$d" == "swayidle -w before-sleep "* ]] &&
                 [[ "$d" == *" timeout 270 caustics-canvasctl dim 1 over 30 --wait || [ \$? -ne 2 ] && loginctl lock-session "* ]] &&
                 [[ "$d" == *" timeout 600 niri msg action power-off-monitors resume niri msg action power-on-monitors "* ]] &&
                 [[ "$d" == *" timeout 1800 systemctl suspend "* ]] &&
                 n=$(TOPAZ_IDLE_WARN=0 TOPAZ_IDLE_SUSPEND=0 /usr/libexec/topaz/idle --print | tr "\n" " ") &&
                 [[ "$n" == *" timeout 300 loginctl lock-session "* ]] &&
                 [[ "$n" != *dim* && "$n" != *suspend* ]] &&
                 o=$(TOPAZ_IDLE_LOCK=0 TOPAZ_IDLE_BLANK=0 TOPAZ_IDLE_SUSPEND=0 /usr/libexec/topaz/idle --print | tr "\n" " ") &&
                 [[ "$o" != *timeout* ]] &&
                 b=$(TOPAZ_IDLE_LOCK=soon /usr/libexec/topaz/idle --print 2>/dev/null | tr "\n" " ") &&
                 [[ "$b" == *" timeout 270 caustics-canvasctl dim"* ]]'
    # The wallpaper follows the base image's own choice and schedule, on
    # the canvas: the month's timed XML Bluefin pins for GNOME, read by
    # the script at noon and at 22:00 of the build day, must name a day
    # and a night image that exist in a format the canvas decodes (JPEG
    # XL most months; SVG since Bluefin's November 2026 artwork, which
    # the canvas renders itself); a knob naming a plain image is shown
    # as is; and a probe schedule of two statics and two transitions
    # resolves a transition to its target, the seconds of fade left and
    # the seconds until the image changes again.
    # --print writes three lines (image, seconds, fade) and bash
    # line-buffers a pipe, so they are three writes: `head -1` can exit
    # between them and kill the script with SIGPIPE (it did, on the CI
    # guest). sed and tr read to EOF and cannot.
    # GNOME gets its wallpaper from the base image for free: Bluefin pins
    # the month's timed XML (a day image, a night image, two cross-fades)
    # in a gschema override. The session reads the same override and
    # drives the canvas from it, so it needs no per-user state;
    # TOPAZ_WALLPAPER in the knob file names another image or XML.
    chk "wallpaper follows the base image's timed schedule on the canvas" \
        bash -c 'set -o pipefail
                 test -x /usr/libexec/topaz/background &&
                 grep -q "caustics-canvasctl show" /usr/libexec/topaz/background &&
                 ! grep -q swaybg /usr/libexec/topaz/background &&
                 grep -q "^ExecStart=/usr/libexec/topaz/background$" /usr/lib/systemd/user/topaz-background.service &&
                 grep -q "^After=graphical-session.target caustics-canvas.service$" /usr/lib/systemd/user/topaz-background.service &&
                 grep -q "^EnvironmentFile=-%h/.config/topaz/session.conf$" /usr/lib/systemd/user/topaz-background.service &&
                 grep -q "^#TOPAZ_WALLPAPER=" /usr/share/topaz-os/session.conf &&
                 xml=$(sed -n "s|^picture-uri-dark=.file://\(.*\).$|\1|p" /usr/share/glib-2.0/schemas/zz0-bluefin-modifications.gschema.override) &&
                 [[ "$xml" == /usr/share/backgrounds/bluefin/*.xml ]] && test -f "$xml" &&
                 day=$(TOPAZ_BACKGROUND_NOW=$(date -d "today 12:00" +%s) /usr/libexec/topaz/background --print | sed -n 1p) &&
                 night=$(TOPAZ_BACKGROUND_NOW=$(date -d "today 22:00" +%s) /usr/libexec/topaz/background --print | sed -n 1p) &&
                 [[ "$day" == *-day.jxl || "$day" == *-day.svg ]] && test -f "$day" &&
                 [[ "$night" == *-night.jxl || "$night" == *-night.svg ]] && test -f "$night" &&
                 [ "$(TOPAZ_WALLPAPER="$night" /usr/libexec/topaz/background --print | sed -n 1p)" = "$night" ] &&
                 probe=$(mktemp --suffix=.xml) &&
                 printf "%s\n" "<background><starttime><hour>0</hour><minute>0</minute><second>0</second></starttime>" \
                     "<static><file>/a.jxl</file><duration>3600.0</duration></static>" \
                     "<transition><duration>1800.0</duration><from>/a.jxl</from><to>/b.jxl</to></transition>" \
                     "<static><file>/b.jxl</file><duration>3600.0</duration></static>" \
                     "<transition><duration>1800.0</duration><from>/b.jxl</from><to>/a.jxl</to></transition>" \
                     "</background>" > "$probe" &&
                 at() { TOPAZ_WALLPAPER=$probe TOPAZ_BACKGROUND_NOW=$(date -d "today $1" +%s) /usr/libexec/topaz/background --print | tr "\n" " "; } &&
                 [ "$(at 00:30)" = "/a.jxl 1800 0 " ] &&
                 [ "$(at 01:15)" = "/b.jxl 4500 900 " ] &&
                 [ "$(at 02:45)" = "/a.jxl 4500 900 " ] &&
                 rm -f "$probe"'
    # caustics (github.com/davidar/caustics), the session's bar, is built
    # from source at a pinned commit: no distribution packages it. The
    # bar, the canvas and their sidecars install as one set under
    # /usr/lib/caustics-bar/<abi-hash>/, and a host refuses a sidecar from
    # another set, so exactly one set ships and nothing else is in it. The
    # shaders are compiled in (no CAUSTICS_DIR, no /usr/share/caustics).
    # The caustics-gpu wrapper pins the Vulkan loader to the integrated
    # GPU's driver, because enumerating the discrete GPU's driver can wake
    # it for the life of the session; the test VM draws with lavapipe.
    # The bar restarts on a crash but not on exit 2 (it refuses to run)
    # or 3 (the GPU device is gone). Its unit is Type=notify with no start
    # timeout: the bar sends READY=1 at the first frame its whole program
    # draws, so "active" means a bar is on screen and a session restore
    # can wait for it; a bar without the signal would sit in `activating`
    # for ever, hence the string check on the binary.
    chk "caustics bar: one set of nineteen binaries, the link into it, the unit and its GPU wrapper" \
        bash -c 'set -o pipefail
                 sets=(/usr/lib/caustics-bar/*/)
                 [ "${#sets[@]}" -eq 1 ] || exit 1
                 set_dir=${sets[0]}; set_hash=$(basename "$set_dir")
                 [ "$(readlink -f /usr/bin/caustics-bar)" = "${set_dir}caustics-bar" ] &&
                 [ "$("${set_dir}caustics-bar" --abi-hash)" = "$set_hash" ] &&
                 [ "$(sed -n "s/^caustics_set=//p" /usr/share/topaz-os/niri-session-build)" = "$set_hash" ] &&
                 for b in caustics-bar caustics-sysmon caustics-tray caustics-power caustics-audio \
                          caustics-network caustics-bluetooth caustics-notify caustics-displays \
                          caustics-apps caustics-glyphs caustics-reload caustics-canvas \
                          caustics-wallpaper caustics-canvasctl caustics-polkit caustics-lock \
                          caustics-secrets caustics-pairing; do
                     test -x "$set_dir$b" || exit 1
                     ! ldd "$set_dir$b" | grep -q "not found" || exit 1
                 done &&
                 [ "$(find "$set_dir" -mindepth 1 | wc -l)" -eq 19 ] &&
                 grep -q "^ExecStart=/usr/libexec/topaz/caustics-gpu caustics-bar$" /usr/lib/systemd/user/caustics-bar.service &&
                 ! grep -q "CAUSTICS_DIR=" /usr/lib/systemd/user/caustics-bar.service &&
                 ! test -e /usr/share/caustics &&
                 grep -q "^RestartPreventExitStatus=2 3$" /usr/lib/systemd/user/caustics-bar.service &&
                 grep -q "^Type=notify$" /usr/lib/systemd/user/caustics-bar.service &&
                 grep -q "^NotifyAccess=main$" /usr/lib/systemd/user/caustics-bar.service &&
                 grep -q "^TimeoutStartSec=infinity$" /usr/lib/systemd/user/caustics-bar.service &&
                 grep -aq "READY=1" "${set_dir}caustics-bar" &&
                 grep -q "^exec \"/usr/bin/\$host\" \"\$@\"$" /usr/libexec/topaz/caustics-gpu &&
                 test -x /usr/libexec/topaz/caustics-gpu &&
                 ! test -e /usr/libexec/topaz/caustics-bar &&
                 test -f /usr/share/vulkan/icd.d/radeon_icd.x86_64.json &&
                 test -f /usr/share/vulkan/icd.d/lvp_icd.x86_64.json'
    # The canvas: the second host of the set, its unit restarting on
    # every exit (it is where the lock screen is drawn), its sidecar list
    # naming the polkit agent, the lock, the secret agent and the pairing
    # sink, the links the units and the
    # scripts start it and its client by, the client running at all (its
    # usage line) outside a session, and what the polkit and lock sinks need: the
    # setuid polkit helper, libpam, the lock's own PAM service (named on
    # the unit, shipped in /etc/pam.d, on the fingerprint-free stack) and
    # libxkbcommon for the prompt's keymap.
    # The caustics canvas draws the wallpaper, the idle dim, the polkit
    # prompt and the lock screen: one process for what swaybg, chayang,
    # cosmic-osd and swaylock did. It restarts on every exit, because a
    # locked session must get its lock client back (the compositor keeps
    # the session locked meanwhile, and the canvas re-locks from logind's
    # LockedHint). The polkit agent, the lock, the secret agent and the
    # pairing sink start only when the unit names them: two agents or two
    # lockers on one session fight. The lock's PAM service is its own file
    # on password-auth: the sidecar's default name, swaylock, would fall
    # to PAM's deny-all `other` now that swaylock is gone, and
    # system-auth's pam_fprintd would add 5 s to every unlock (the lock
    # takes fingerprints through fprintd itself).
    chk "caustics canvas: the unit, its restart rule, its sidecars, the links and the client" \
        bash -c 'set -o pipefail
                 u=/usr/lib/systemd/user/caustics-canvas.service
                 grep -q "^ConditionEnvironment=XDG_SESSION_DESKTOP=topaz$" $u &&
                 grep -q "^ExecStart=/usr/libexec/topaz/caustics-gpu caustics-canvas$" $u &&
                 grep -q "^Restart=always$" $u &&
                 ! grep -q "^RestartPreventExitStatus" $u &&
                 ! grep -q "CAUSTICS_DIR=" $u &&
                 grep -q "^Environment=CAUSTICS_SIDECARS=\"caustics-wallpaper caustics-reload caustics-glyphs caustics-polkit caustics-lock caustics-secrets caustics-pairing\"$" $u &&
                 grep -q "^Environment=CAUSTICS_LOCK_PAM_SERVICE=caustics-lock$" $u &&
                 test -L /etc/systemd/user/graphical-session.target.wants/caustics-canvas.service &&
                 set_dir=$(dirname "$(readlink -f /usr/bin/caustics-bar)") &&
                 [ "$(readlink -f /usr/bin/caustics-canvas)" = "$set_dir/caustics-canvas" ] &&
                 [ "$(readlink -f /usr/bin/caustics-canvasctl)" = "$set_dir/caustics-canvasctl" ] &&
                 { caustics-canvasctl 2>&1 || true; } | grep -q "^usage: caustics-canvasctl" &&
                 test -u /usr/lib/polkit-1/polkit-agent-helper-1 &&
                 test -f /usr/lib64/libpam.so.0 &&
                 grep -qE "^auth\s+include\s+password-auth$" /etc/pam.d/caustics-lock &&
                 ! grep -q pam_fprintd /etc/pam.d/password-auth &&
                 test -f /usr/lib64/libxkbcommon.so.0'
    # niri 26.04 skips a startup spawn whose binary is missing without a
    # word (the spawner deadlocks on the exec error), so resolve every
    # target here instead of finding out at login.
    chk "every spawn-at-startup target in the baked niri config exists" \
        bash -c 'set -o pipefail
                 { grep -h "^spawn-at-startup " /etc/niri/*.kdl || true; } |
                     sed "s/^spawn-at-startup \"\([^\"]*\)\".*/\1/" |
                     while read -r cmd; do
                         case $cmd in
                         /*) test -x "$cmd" ;;
                         *) command -v "$cmd" >/dev/null ;;
                         esac || { echo "missing spawn target: $cmd" >&2; exit 1; }
                     done'
    # xdg-desktop-portal routes an interface to the first backend whose
    # .portal file declares it and never probes what the backend exports.
    # portal-gnome declares far more than it serves outside GNOME, so the
    # packaged default=gnome;gtk; sent FileChooser into "no such
    # interface". The default is gtk first, with ScreenCast, Screenshot
    # and Settings named for gnome: niri implements the Mutter ScreenCast
    # and Shell Screenshot D-Bus APIs that backend drives, and its
    # Settings answers from gsettings. The baked niri config floats
    # portal dialogs by app-id, since niri cannot tie them to a parent.
    # Post-boot: a file dialog, a screen-share picker, a portal
    # screenshot.
    chk "niri session portals: gtk first; ScreenCast, Screenshot and Settings on gnome" \
        bash -c 'grep -q "^default=gtk;gnome;$" \
                     /usr/share/xdg-desktop-portal/niri-portals.conf &&
                 grep -q "^org.freedesktop.impl.portal.FileChooser=gtk;$" \
                     /usr/share/xdg-desktop-portal/niri-portals.conf &&
                 grep -q "^org.freedesktop.impl.portal.ScreenCast=gnome;$" \
                     /usr/share/xdg-desktop-portal/niri-portals.conf &&
                 grep -q "^org.freedesktop.impl.portal.Screenshot=gnome;$" \
                     /usr/share/xdg-desktop-portal/niri-portals.conf &&
                 grep -q "^org.freedesktop.impl.portal.Settings=gnome;$" \
                     /usr/share/xdg-desktop-portal/niri-portals.conf &&
                 ! grep -q "Cosmic" /etc/niri/config.kdl &&
                 grep -qF "portal\\.desktop\\.gtk" /etc/niri/config.kdl &&
                 grep -q "impl.portal.FileChooser" /usr/share/xdg-desktop-portal/portals/gtk.portal &&
                 grep -q "impl.portal.ScreenCast" /usr/share/xdg-desktop-portal/portals/gnome.portal &&
                 grep -q "impl.portal.Screenshot" /usr/share/xdg-desktop-portal/portals/gnome.portal &&
                 grep -q "impl.portal.Settings" /usr/share/xdg-desktop-portal/portals/gnome.portal &&
                 ! test -e /usr/share/xdg-desktop-portal/portals/cosmic.portal &&
                 ! test -e /usr/libexec/xdg-desktop-portal-cosmic'
    # The session has no settings application. The bar and the canvas
    # cover the daily cases and the rest is done in a terminal, which also
    # works over ssh: one packaged tool per domain, nothing enabled.
    chk "terminal settings tools: one packaged tool per domain the shell leaves to a terminal" \
        bash -c 'for b in nmtui wiremix kanshi wlr-randr wlsunset grim slurp wf-recorder btop ncdu gdu bashmount; do
                     command -v $b > /dev/null || { echo "missing: $b" >&2; exit 1; }
                 done &&
                 ! command -v brightnessctl > /dev/null'
    # greetd runs tuigreet on VT 1 in place of GDM. A terminal greeter
    # shares no compositor, toolkit or GPU driver with the sessions it
    # starts, so a broken session cannot take the login screen with it.
    # Its auth stack is password-auth, not system-auth: tuigreet runs the
    # PAM conversation in order, so pam_fprintd's 5 s would precede every
    # password prompt, for a fingerprint that cannot unlock the keyring.
    # Fedora's tuigreet keeps its remember-records in the greeter's home,
    # which an empty /var leaves root-owned: hence the tmpfiles rule.
    # Rescue: VT 2, `systemctl disable greetd && systemctl enable gdm`,
    # reboot.
    chk "greetd with tuigreet is the display manager" \
        bash -c '[ "$(basename "$(readlink /etc/systemd/system/display-manager.service)")" = greetd.service ] &&
                 ! systemctl is-enabled gdm.service > /dev/null 2>&1 &&
                 grep -q "^vt = 1$" /etc/greetd/config.toml &&
                 grep -q "^command = \"tuigreet .*--remember --remember-user-session" /etc/greetd/config.toml &&
                 grep -q "^user = \"greetd\"$" /etc/greetd/config.toml &&
                 test -x /usr/bin/tuigreet &&
                 grep -q "^d /var/lib/greetd 0755 greetd greetd" /usr/lib/tmpfiles.d/topaz-greetd-home.conf &&
                 grep -qE "^auth\s+substack\s+password-auth$" /usr/lib/pam.d/greetd &&
                 ! grep -qE "^auth\s+.*system-auth" /usr/lib/pam.d/greetd'
    # Since Fedora 45 the keyring is oo7. pam_oo7 does not start the
    # daemon; only GNOME's session target does, and nothing D-Bus-activates
    # org.freedesktop.secrets. Outside GNOME the login password went to a
    # helper that timed out, and applications had no keyring. The unit is
    # enabled for every user. Post-boot (hardware): a password login
    # unlocks the login collection without a prompt.
    chk "Secret Service starts in every session: oo7-daemon is enabled for all users" \
        bash -c 'test -x /usr/libexec/oo7-daemon &&
                 grep -q "^BusName=org.freedesktop.secrets$" /usr/lib/systemd/user/oo7-daemon.service &&
                 test -L /etc/systemd/user/default.target.wants/oo7-daemon.service &&
                 grep -q "^enable oo7-daemon.service$" /usr/lib/systemd/user-preset/45-topaz.preset &&
                 grep -qE "^-?session\s+optional\s+pam_oo7\.so\s+auto_start$" /usr/lib/pam.d/greetd'
    # oo7-daemon asks to lock its memory and is refused (the user manager's
    # 8 MiB RLIMIT_MEMLOCK), and this image swaps to a file on disk, so an
    # unlocked keyring could be written there in the clear. A drop-in
    # forbids swap for the daemon's cgroup instead. Post-boot:
    # memory.swap.max of the unit's cgroup reads 0.
    chk "the keyring daemon's memory is never swapped" \
        grep -qx 'MemorySwapMax=0' \
            /usr/lib/systemd/user/oo7-daemon.service.d/10-topaz-no-swap.conf
    # ddcutil's and OpenRGB's udev rules gave the seated user an ACL on
    # every /dev/i2c-*, the DDC/CI buses behind the display connectors
    # included. On this hardware (Radeon 780M, PSR-capable eDP) a raw AUX
    # transaction to a disconnected port before the panel's first PSR
    # arming hangs that arming for good, and cosmic-settings-daemon probed
    # every bus at login: sessions froze at the first idle moment. No rule
    # may grant the access; `sudo ddcutil` still works.
    chk "no unprivileged DDC/CI i2c access (COSMIC freeze mitigation)" \
        bash -c '! grep -h i2c /usr/lib/udev/rules.d/*.rules | grep -v "^#" | grep -q uaccess'
    # Panel Self Refresh is off (amdgpu.dcdebugmask=0x10). With the i2c
    # door closed the same DMCUB wedge (flip_done timed out, display dead
    # until reboot) still struck mid-session, and a hard freeze also
    # discards a staged update. With PSR never armed, its entry cannot
    # hang. Costs about 1 W on a static screen; revisit when amdgpu or
    # DMUB is fixed. Post-boot: grep amdgpu.dcdebugmask /proc/cmdline.
    chk "eDP Panel Self Refresh is disabled (DMUB wedge mitigation)" \
        grep -q 'amdgpu.dcdebugmask=0x10' /usr/lib/bootc/kargs.d/10-topaz-display.toml
    # The boot is shown as text, not hidden behind a splash: Plymouth is
    # off, systemd prints its status lines and the kernel its messages.
    # An installer leaves `rhgb quiet` on the machine and an image cannot
    # remove arguments it did not add, so each argument here overrides
    # one of those (image arguments come later on the command line, and
    # the later loglevel wins). Once the greeter is about to take the
    # screen a unit lowers the kernel's console level to the one `quiet`
    # gives, so nothing is written across the greeter or a text login,
    # and raises it again for shutdown. Post-boot: the log is on screen,
    # and the first field of /proc/sys/kernel/printk reads 3 at the
    # greeter.
    chk "the boot log is shown as text: no splash, systemd status and kernel messages" \
        bash -c 'f=/usr/lib/bootc/kargs.d/20-topaz-console.toml &&
                 grep -q "\"plymouth.enable=0\"" $f &&
                 grep -q "\"systemd.show_status=true\"" $f &&
                 grep -q "\"loglevel=7\"" $f &&
                 grep -q "^ConditionKernelCommandLine=!plymouth.enable=0$" \
                     /usr/lib/systemd/system/plymouth-start.service &&
                 u=topaz-console-loglevel.service &&
                 grep -qx "ExecStart=/usr/bin/dmesg --console-level crit" /usr/lib/systemd/system/$u &&
                 grep -qx "ExecStop=/usr/bin/dmesg --console-level debug" /usr/lib/systemd/system/$u &&
                 test -L /etc/systemd/system/multi-user.target.wants/$u'
    # Windows is in the GRUB menu on a machine that has it. bootupd's
    # static grub.cfg is written once, at install, and never probes for
    # other systems; it ends by reading custom.cfg beside it. A unit
    # copies the image's custom.cfg there at boot: one entry that searches
    # the EFI partitions for Windows' loader and is absent when there is
    # none. A custom.cfg that is not the image's is left alone. Post-boot:
    # /boot/grub2/custom.cfg equals the shipped file. (`topaz boot-order`
    # is the companion: Windows can put itself first in the firmware's
    # boot order when it starts.)
    chk "GRUB menu additions ship, parse, and are installed at boot" \
        bash -c 'f=/usr/share/topaz-os/grub-custom.cfg &&
                 grub2-script-check $f &&
                 grep -q "chainloader /EFI/Microsoft/Boot/bootmgfw.efi" $f &&
                 grep -q "source \$prefix/custom\.cfg" \
                     /usr/lib/bootupd/grub2-static/configs.d/41_custom.cfg &&
                 test -x /usr/libexec/topaz/grub-entries &&
                 u=topaz-grub-entries.service &&
                 grep -qx "ExecStart=/usr/libexec/topaz/grub-entries" /usr/lib/systemd/system/$u &&
                 test -L /etc/systemd/system/multi-user.target.wants/$u'
    # simpledrm, the kernel's driver for the framebuffer the firmware
    # leaves behind, is allowed to load. The base turns it off
    # (initcall_blacklist=simpledrm_platform_driver_init), a workaround
    # from when the NVIDIA driver neither evicted it nor provided a
    # console of its own, so that both ended up driving one display.
    # Since then nvidia-drm registers a framebuffer console by default
    # and removes the firmware framebuffer it conflicts with, as amdgpu
    # always did. With simpledrm off nothing shows the boot log until
    # the GPU driver is up, seconds in. Only that argument is dropped;
    # the base's other NVIDIA arguments stay. Post-boot: the log is on
    # screen from the first second, the session renders on the GPU, and
    # /sys/class/drm lists no card driven by simple-framebuffer.
    chk "the firmware framebuffer shows the boot log until the GPU driver loads" \
        bash -c 'f=/usr/lib/bootc/kargs.d/00-nvidia.toml &&
                 ! grep -rq simpledrm /usr/lib/bootc/kargs.d/ &&
                 grep -q "\"nvidia-drm.modeset=1\"\]$" $f &&
                 grep -q "\"modprobe.blacklist=nouveau\"" $f'
    # The console font is Terminus 12x24. The kernel builds in 8x16 only,
    # a 360-column grid on a 2880-pixel panel, and the base configures no
    # other, for the boot log, the greeter and every text console alike.
    # It is named by a kernel argument, which systemd-vconsole-setup
    # reads in the initramfs as in the booted system and which, unlike
    # /etc/vconsole.conf, reaches machines whose copy of that file was
    # written locally. For the first lines of the log to use it, the font
    # file is appended to the base's initramfs as a second archive; the
    # base's own bytes stay an untouched prefix (regenerating with dracut
    # would also pull in what later base layers added). The initramfs is
    # readable by root only, so an unprivileged run checks the rest.
    chk "the console font is Terminus 12x24, from the first lines of the boot log" \
        bash -c 'grep -q "\"vconsole.font=ter-v24n\"" /usr/lib/bootc/kargs.d/20-topaz-console.toml &&
                 . /usr/share/topaz-os/initramfs-font &&
                 [ "$font" = usr/lib/kbd/consolefonts/ter-v24n.psf.gz ] &&
                 test -f "/$font" &&
                 set -- /usr/lib/modules/*/initramfs.img && [ $# -eq 1 ] &&
                 { [ ! -r "$1" ] || {
                     set -o pipefail &&
                     [ "$(head -c "$base_size" "$1" | sha256sum | cut -d" " -f1)" = "$base_sha256" ] &&
                     [ "$(tail -c +$((base_size + 1)) "$1" | zstd -dc | cpio --list --quiet)" = "$font" ] &&
                     tail -c +$((base_size + 1)) "$1" | zstd -dc | cpio --extract --to-stdout --quiet | cmp -s - "/$font"; }; }'
    # PAM runs pam_fprintd ahead of the password module, and its default
    # timeout is 30 s: half a minute before a password can be typed. A
    # custom authselect profile symlinks every file to the base `local`
    # profile, so upstream changes flow through, except system-auth,
    # which is patched to timeout=5. The state file is compared exactly
    # because the CI build environment once committed it torn (new size,
    # old blocks) with every tool exiting 0.
    chk "fingerprint PAM timeout is 5s" \
        grep -q 'pam_fprintd.so timeout=5' /etc/pam.d/system-auth
    chk "authselect profile symlinks to the base profile" \
        test -L /etc/authselect/custom/local-custom/password-auth
    chk "authselect state file records the custom profile" \
        bash -c '[ "$(cat /etc/authselect/authselect.conf)" = "$(printf \
            "custom/local-custom\nwith-fingerprint\nwith-silent-lastlog\nwith-mdns4")" ]'
    # Playwright and other automation hardcode /opt/google/chrome/chrome.
    # Chrome here is a Flatpak, so a tmpfiles.d rule links that path to
    # the Flatpak's exported wrapper at boot (a dangling link is
    # harmless).
    chk "Playwright Chrome path rule is present" \
        test -f /usr/lib/tmpfiles.d/topaz-chrome-path.conf
    # supergfxd (GPU mode switching on hybrid laptops) ships in the base
    # with its service off; a preset enables it so a fresh install has
    # it.
    chk "supergfxd is enabled" \
        bash -c 'ls /etc/systemd/system/*.wants/supergfxd.service >/dev/null 2>&1'
    # Fedora ships speech-dispatcher's socket disabled, which costs
    # Flatpak browsers their text-to-speech.
    chk "speech-dispatcher user preset is present" \
        grep -q 'enable speech-dispatcher.socket' /usr/lib/systemd/user-preset/45-topaz.preset
    # Userland (per-user services, recipes, installers) lives in the
    # topaz-home companion repo and updates at git speed; the image keeps
    # what needs atomic updates and rollback. Its one hook here is the
    # `ujust topaz-home` recipe, which clones and never applies.
    chk "topaz-home bootstrap recipe is present" \
        bash -c 'test -f /usr/share/ublue-os/just/60-custom.just &&
                 grep -q "^topaz-home" \
                     /usr/share/ublue-os/just/60-custom.just'
    # KDE Connect runs in a distrobox (topaz-home) that shares the host's
    # network namespace, so pairing still needs the host firewall to pass
    # its ports: host state a per-user recipe cannot own.
    # The zone dir is root-only readable, so unprivileged runs skip the
    # grep; the build gate runs as root and asserts it.
    chk "KDE Connect firewall ports are open" \
        bash -c '[ ! -r /etc/firewalld/zones/FedoraWorkstation.xml ] ||
                 grep -q "service name=\"kdeconnect\"" \
                     /etc/firewalld/zones/FedoraWorkstation.xml'
    # `topaz dev` daily-drives locally built binaries on a transient /usr
    # overlay (bootc usroverlay) that a reboot discards.
    chk "bootc is available for dev overlays" \
        command -v bootc
    # Updates. CI rewrites the image into ~400 content-based layers
    # (chunkah, roughly one per package) and publishes them zstd:chunked
    # to quay.io, which serves the multi-range requests partial pulls
    # need (GHCR answers 501). The client half is here: partial pulls
    # switched on in containers-storage, and `topaz pull`, which fetches
    # with podman (parallel and partial) and hands the result to bootc,
    # whose own fetcher is serial and whole-layer (bootc#20). The timer
    # stages the update at 03:30, ahead of uupd's window, and the service
    # retries because a missed run fires at resume, seconds before the
    # network is back.
    chk "podman, jq and skopeo are present for parallel pulls (topaz pull)" \
        bash -c 'command -v podman && command -v jq && command -v skopeo'
    chk "partial image pulls are enabled in containers-storage" \
        grep -qx 'enable_partial_images = "true"' /usr/share/containers/storage.conf
    chk "topaz-pull.timer stages updates ahead of uupd" \
        bash -c 'ls /etc/systemd/system/timers.target.wants/topaz-pull.timer >/dev/null 2>&1'
    chk "topaz-pull.service retries a pull that fires into a resume" \
        bash -c 'grep -qx "Restart=on-failure" /usr/lib/systemd/system/topaz-pull.service &&
                 grep -qx "StartLimitBurst=5" /usr/lib/systemd/system/topaz-pull.service'
    # Reproducibility: the same commit must rebuild to the same bytes, so
    # any difference between two builds is a finding. rpm install times
    # are clamped to SOURCE_DATE_EPOCH (derived from the base image,
    # recorded in this one) plus an install-order ordinal.
    chk "package install metadata is reproducible" \
        bash -c 'sde=$(cat /usr/share/topaz-os/source-date-epoch) &&
                 for p in cosmic-files nethogs; do
                     t=$(rpm -q --qf "%{INSTALLTIME}" "$p")
                     [ $((t - sde)) -ge 0 ] && [ $((t - sde)) -lt 1000 ] || exit 1
                 done'
    # sqlite WAL sidecars hold runtime state and any rpm query recreates
    # them, but a WAL database without them cannot be opened from
    # read-only /usr. The build converts the database to DELETE journal
    # mode after its last write.
    chk "rpm database is readable from read-only /usr (DELETE journal mode)" \
        bash -c '[ "$(od -A n -j 18 -N 2 -t u1 /usr/share/rpm/rpmdb.sqlite |
                      tr -s " ")" = " 1 1" ]'
    # authselect snapshots what it replaces into a randomly named
    # directory; the build passes --nobackup.
    chk "no build-time authselect backup is baked into the image" \
        bash -c '! ls /usr/lib/authselect/backups/ 2>/dev/null | grep -q .'
    # The CI build environment has committed files torn through overlayfs
    # copy-ups (NUL-tailed catalogs, a SELinux module store abandoned
    # mid-transaction with greetd's policy missing) while every tool
    # exited 0, so these verify the state the tools should have left. On
    # a booted machine the module store is root-only: an unprivileged run
    # reports that check failed.
    chk "XML catalogs are intact (well-formed XML)" \
        bash -c 'xmllint --noout /etc/xml/catalog &&
                 xmllint --noout /etc/sgml/docbook/xmlcatalog'
    chk "SELinux module store is committed cleanly" \
        bash -c '! test -e /etc/selinux/targeted/previous &&
                 ! test -e /etc/selinux/targeted/tmp &&
                 ! test -e /etc/selinux/final/targeted &&
                 test -d /etc/selinux/targeted/active/modules/200/greetd'
    # buildah sometimes commits the empty /ctx bind-mount target; the
    # build gate removes it, and a non-empty one fails here.
    chk "no leftover build-mount debris in the image root" \
        bash -c '! test -e /ctx'
    # libxml2 writes SGML catalogs in per-process hash order; the build
    # sorts them. The files exist only while some dependency pulls
    # docbook-dtds (none does since the kde-connect subtree left); absent
    # is canonical.
    chk "sgml catalogs are in canonical order" \
        bash -c 'for f in /etc/sgml/catalog /etc/sgml/*.cat; do
                     [ -e "$f" ] || continue
                     [ -L "$f" ] && continue
                     LC_ALL=C sort -C "$f" || exit 1
                 done'
    # The build installs exactly the closure in packages.lock: one +NEVRA
    # or -NEVRA line per package relative to the pinned base, weak
    # dependencies off, from downloaded files, with koji as the source
    # for builds the mirrors have dropped. Repository state can neither
    # change nor break a build; updates arrive as a reviewed lock diff.
    chk "installed package set matches the shipped lockfile" \
        bash -c 'lock=/usr/share/topaz-os/packages.lock
                 rpm -q $(sed -n "s/^+//p" "$lock" | cut -d" " -f1) \
                     > /dev/null || exit 1
                 sed -n "s/^[-~]//p" "$lock" | cut -d" " -f1 \
                     | xargs -r -n1 rpm -q 2>/dev/null \
                     | grep -qv "is not installed" && exit 1; true'
    # Mirror repository names drift under an unchanged lock (updates →
    # updates-archive → koji); the locked install records @commandline
    # instead so the libdnf5 state reproduces.
    chk "libdnf5 names no mirror repository for locked packages" \
        bash -c 'sed -n "s/^+//p" /usr/share/topaz-os/packages.lock \
                     | cut -d" " -f1 | sed "s/-0:/-/" \
                     | grep -F -f - /usr/lib/sysimage/libdnf5/nevras.toml \
                     | grep -qE "from_repo = \"(fedora|updates|updates-archive|updates-testing)\"" \
                     && exit 1; true'
    # cosmic-initial-setup and cosmic-wallpapers rode in on cosmic-session
    # and served nothing here; neither may return.
    chk "trimmed app-suite packages are absent" \
        bash -c '! rpm -q cosmic-initial-setup > /dev/null 2>&1 &&
                 ! rpm -q cosmic-wallpapers > /dev/null 2>&1'
    # Base-image udev rules name the Debian-style plugdev group, which
    # Fedora lacks: about 100 "Failed to resolve group" errors at every
    # rules load.
    chk "plugdev group is declared for base-image udev rules" \
        grep -q '^g plugdev' /usr/lib/sysusers.d/topaz-plugdev.conf
    # Flatpak system monitors (Mission Center) delegate per-process
    # network attribution to a host nethogs carrying these capabilities;
    # their own setcap helper cannot write an immutable /usr.
    chk "nethogs holds packet-capture file capabilities" \
        bash -c '[ "$(getcap /usr/sbin/nethogs)" = \
            "/usr/sbin/nethogs cap_dac_read_search,cap_net_admin,cap_net_raw,cap_sys_ptrace=ep" ]'
    # /var is machine state: the image's copy is materialised once at
    # install and never updated, so anything shipped there is dead weight
    # and a reproducibility hazard (dnf's countme cookies are random).
    # The one functional item, the greetd package's portal mask, is a
    # tmpfiles.d rule instead.
    chk "greeter portal mask ships declaratively (tmpfiles.d, not /var content)" \
        grep -q 'xdg-desktop-portal.service - - - - /dev/null' \
            /usr/lib/tmpfiles.d/topaz-greetd-portal-mask.conf
    # Build-container only: a booted machine's /var is legitimate machine
    # state; the image must ship none (only an empty /var/tmp, matching
    # the base — build debris there churns rebuilds).
    if [ ! -e /run/ostree-booted ]; then
        # List offenders before the verdict — chk swallows command output,
        # and a bare FAIL from a remote build log is undebuggable.
        local stray
        stray="$(find /var -mindepth 1 -not -path /var/tmp)"
        [ -z "$stray" ] || printf 'stray /var content:\n%s\n' "$stray"
        chk "image ships an empty /var" test -z "$stray"
    fi
    if overlay_active; then
        echo
        echo "[DEV ] A transient /usr overlay is ACTIVE — this system currently"
        echo "[DEV ] deviates from the signed image. 'topaz dev status' lists the"
        echo "[DEV ] installed binaries; a reboot returns to the image."
    fi
    echo
    if [ "$fails" -eq 0 ]; then
        echo "All deviations hold."
    else
        echo "$fails check(s) failed — the image no longer matches what it claims."
        exit 1
    fi
}

# --- dev: transient /usr overlay for daily-driving locally built binaries ---
# The image is the signed trunk; experiments live in a bootc usroverlay that
# a reboot fully discards. Installed files are recorded in a tmpfs manifest
# so the deviation is always visible (topaz dev status, topaz check).

overlay_active() {
    findmnt -n /usr >/dev/null 2>&1
}

cmd_dev() {
    case "${1:-status}" in
    on)
        if overlay_active; then
            echo "Transient /usr overlay is already active."
        else
            echo "Arming a transient overlay on /usr (bootc usroverlay)."
            echo "Changes under /usr persist until reboot, then vanish."
            pkexec bootc usroverlay
        fi
        ;;
    install)
        [ $# -ge 2 ] || { echo "Usage: topaz dev install <file> [dest]"; exit 1; }
        local src dest sum
        src=$(realpath "$2")
        dest="${3:-/usr/bin/$(basename "$src")}"
        [ -f "$src" ] || { echo "No such file: $src"; exit 1; }
        overlay_active || { echo "No overlay active — run 'topaz dev on' first."; exit 1; }
        sum=$(sha256sum "$src" | cut -d' ' -f1)
        pkexec bash -c "install -m0755 '$src' '$dest' &&
                        mkdir -p /run/topaz-dev &&
                        printf '%s\t%s\t%s\t%s\n' '$dest' '$sum' '$src' \"\$(date -Is)\" \
                            >> $DEV_MANIFEST"
        echo "Installed $dest (sha256 ${sum:0:12}…, gone after reboot)."
        if pgrep -x "$(basename "$dest")" >/dev/null 2>&1; then
            echo "Note: $(basename "$dest") is currently running the old binary;"
            echo "restart it (or the session) to pick up the new one."
        fi
        ;;
    status)
        if overlay_active; then
            echo "Transient /usr overlay: ACTIVE (reboot returns to the signed image)"
            if [ -s "$DEV_MANIFEST" ]; then
                echo "Installed dev binaries:"
                awk -F'\t' '{printf "  %s  %.12s…  from %s  (%s)\n", $1, $2, $3, $4}' \
                    "$DEV_MANIFEST"
            else
                echo "No dev binaries recorded (manifest empty)."
            fi
        else
            echo "Transient /usr overlay: not active — /usr matches the signed image."
        fi
        ;;
    off)
        if overlay_active; then
            echo "The overlay is transient: reboot to return to the signed image."
        else
            echo "No overlay active."
        fi
        ;;
    *)
        echo "Usage: topaz dev [on|install <file> [dest]|status|off]"
        exit 1
        ;;
    esac
}

# --- pull: parallel-fetch big updates, then stage them via bootc ------------
# bootc downloads layers serially through its image proxy (bootc#20), which
# wastes most of a fast link — and content-based layers add a
# round trip per layer. podman downloads layers in parallel. For big pulls
# (tag switches, the first fetch after a layer-scheme change — not small
# incremental updates, where serial is fine) this fetches with podman into
# root's containers-storage, imports locally, repoints the origin back at
# the registry so automatic updates keep tracking it (a no-op fetch: every
# layer is already imported), and drops the podman copy. Disk usage doubles
# while the image transiently exists in both stores.

cmd_pull() {
    [ "$(id -u)" -eq 0 ] || {
        echo "topaz pull needs root (try: pkexec topaz pull)"
        exit 1
    }
    local image="${1:-}" spec
    spec=$(bootc status --format json)
    if [ -z "$image" ]; then
        local transport
        transport=$(jq -r '.spec.image.transport' <<<"$spec")
        [ "$transport" = registry ] || {
            echo "Origin transport is '$transport', not a registry —"
            echo "pass the image to fetch explicitly: topaz pull <registry-ref>"
            exit 1
        }
        image=$(jq -r '.spec.image.image' <<<"$spec")
    fi
    # No-op when the registry holds nothing new: safe to run from a timer,
    # and skips a redundant restage on manual re-runs. Only when pulling
    # the current origin — an explicit different reference is a deliberate
    # switch and must always reach bootc, even if the content is already
    # present (e.g. repointing the origin back at the registry).
    local remote
    if [ "$image" = "$(jq -r '.spec.image.image // empty' <<<"$spec")" ]; then
        remote="sha256:$(skopeo inspect --no-tags --raw "docker://$image" \
            | sha256sum | cut -d' ' -f1)"
        if [ "$remote" = "$(jq -r '.status.staged.image.imageDigest // empty' <<<"$spec")" ] \
            || [ "$remote" = "$(jq -r '.status.booted.image.imageDigest // empty' <<<"$spec")" ]; then
            echo "Already up to date ($remote staged or booted)."
            exit 0
        fi
    fi
    echo "Fetching $image with parallel layer downloads…"
    local old_id new_id
    old_id=$(podman image inspect --format '{{.Id}}' "$image" 2>/dev/null || true)
    # A partial pull reads each layer's chunk table with a multi-range
    # request; one truncated read of that response fails the whole pull,
    # and podman's own retry did not cover it (observed 2026-09-01). Layers
    # already committed to storage are not fetched again, so a bounded
    # retry resumes the pull rather than restarting it.
    local attempt
    for attempt in 1 2 3; do
        podman pull "$image" && break
        [ "$attempt" -lt 3 ] || {
            echo "podman pull failed $attempt times; nothing staged."
            exit 1
        }
        echo "podman pull failed (attempt $attempt of 3); retrying in 10 s…"
        sleep 10
    done
    new_id=$(podman image inspect --format '{{.Id}}' "$image")
    echo "Importing into bootc from local container storage…"
    bootc switch --transport containers-storage "$image"
    echo "Repointing the origin at the registry (all layers already imported)…"
    bootc switch "$image"
    # The fresh podman copy stays: it is the delta base for the next
    # partial pull — worth its ~5 GiB standing cost in /var.
    # Only the copy it supersedes is reclaimed.
    if [ -n "$old_id" ] && [ "$old_id" != "$new_id" ]; then
        echo "Reclaiming the superseded delta base…"
        podman rmi "$old_id" > /dev/null \
            || echo "note: could not remove superseded image $old_id (extra tags?)"
    fi
    echo
    echo "Staged. Reboot cleanly to activate — a power cut discards staged"
    echo "deployments."
}

# --- boot-order: the firmware's boot order ----------------------------------
# Another operating system on the same disk can put its own entry first in
# the firmware's boot order when it starts (Windows writes a new "Windows
# Boot Manager" entry at the front), after which the machine no longer
# boots this one by default. `topaz boot-order` shows the order; `topaz
# boot-order fix` moves the entry this boot came from back to the front and
# leaves every other entry, and their order, as they were.

boot_order_read() { # sets bo_current, bo_order, bo_listing
    bo_listing=$(efibootmgr 2>/dev/null) || {
        echo "efibootmgr cannot read the firmware's boot entries (not booted through UEFI?)"
        exit 1
    }
    bo_current=$(sed -n 's/^BootCurrent: *//p' <<<"$bo_listing")
    bo_order=$(sed -n 's/^BootOrder: *//p' <<<"$bo_listing")
    [ -n "$bo_current" ] && [ -n "$bo_order" ] || {
        echo "The firmware reports no BootCurrent or no BootOrder; nothing to compare."
        exit 1
    }
}

boot_order_label() { # boot_order_label <number>
    sed -n "s/^Boot$1\*\{0,1\} *\([^\t]*\).*/\1/p" <<<"$bo_listing" | sed 's/ *$//'
}

cmd_boot_order() {
    local bo_current bo_order bo_listing entry rest wanted
    boot_order_read
    case "${1:-status}" in
    status)
        echo "Booted from: $bo_current ($(boot_order_label "$bo_current"))"
        echo "Boot order:"
        for entry in ${bo_order//,/ }; do
            echo "  $entry  $(boot_order_label "$entry")"
        done
        if [ "${bo_order%%,*}" = "$bo_current" ]; then
            echo "The booted entry is first."
        else
            echo "The booted entry is NOT first: the firmware boots" \
                 "'$(boot_order_label "${bo_order%%,*}")' by default."
            echo "To put it back: pkexec topaz boot-order fix"
            return 1
        fi
        ;;
    fix)
        if [ "${bo_order%%,*}" = "$bo_current" ]; then
            echo "The booted entry ($bo_current) is already first; nothing changed."
            return 0
        fi
        [ "$(id -u)" -eq 0 ] || {
            echo "topaz boot-order fix needs root (try: pkexec topaz boot-order fix)"
            exit 1
        }
        rest=""
        for entry in ${bo_order//,/ }; do
            [ "$entry" = "$bo_current" ] || rest="$rest,$entry"
        done
        wanted="$bo_current$rest"
        echo "Boot order was: $bo_order"
        efibootmgr --bootorder "$wanted" >/dev/null
        # Read it back: the firmware, not efibootmgr's exit status, says
        # whether the order was stored.
        boot_order_read
        if [ "$bo_order" = "$wanted" ]; then
            echo "Boot order is:  $bo_order"
            echo "'$(boot_order_label "$bo_current")' boots by default again."
        else
            echo "The firmware did not keep the new order (it reads $bo_order)."
            exit 1
        fi
        ;;
    *) usage 1 ;;
    esac
}

case "${1:-}" in
    check)      cmd_check ;;
    boot-order) shift; cmd_boot_order "$@" ;;
    dev)        shift; cmd_dev "$@" ;;
    pull)       shift; cmd_pull "$@" ;;
    -h|--help|"") usage ;;
    *) usage 1 ;;
esac
