#!/bin/bash
# topaz — the topaz-os system companion.
#
#   topaz why <path>     Why does this file deviate from the base image?
#   topaz ledger         List all recorded deviations
#   topaz check          Verify the image's recorded deviations actually hold
#   topaz report         Show the most recent night-shift report
#   topaz nightshift ... Manage the night-shift triage timer
set -euo pipefail

LEDGER_DIR="${TOPAZ_LEDGER_DIR:-/usr/share/topaz-os/ledger}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/topaz"

usage() {
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

strip_frontmatter() {
    awk 'BEGIN{fm=0} /^---$/{fm++; next} fm!=1{print}' "$1"
}

entry_title() {
    awk -F': *' '/^title:/{print $2; exit}' "$1"
}

cmd_ledger() {
    local f
    for f in "$LEDGER_DIR"/*.md; do
        [ -e "$f" ] || { echo "No ledger entries found in $LEDGER_DIR"; exit 1; }
        printf '%s  %s\n' "$(basename "$f" .md)" "$(entry_title "$f")"
    done
}

cmd_why() {
    local query="${1%/}" f found=0
    for f in "$LEDGER_DIR"/*.md; do
        [ -e "$f" ] || break
        if awk -v q="$query" '
            BEGIN{fm=0; hit=1}
            /^---$/{fm++; next}
            fm==1 && /^  - /{sub(/^  - /,""); if ($0==q) {hit=0; exit}}
            END{exit hit}
            ' "$f"; then
            found=1
            strip_frontmatter "$f"
            echo
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "No ledger entry covers '$query'."
        echo "It likely comes from the base image (see: https://docs.projectbluefin.io/)"
        echo "or was changed locally on this machine outside the image."
        exit 1
    fi
}

# --- checks: each recorded deviation must actually hold on this system ------

fails=0
chk() { # chk <description> <command...>
    local desc="$1"; shift
    if "$@" >/dev/null 2>&1; then
        printf '[ ok ] %s\n' "$desc"
    else
        printf '[FAIL] %s\n' "$desc"
        fails=$((fails + 1))
    fi
}

cmd_check() {
    chk "earlyoom is enabled" \
        test -L /etc/systemd/system/multi-user.target.wants/earlyoom.service
    chk "earlyoom config has swap threshold (-s 50)" \
        grep -q -- '-s 50' /etc/default/earlyoom
    chk "GTK4 GL renderer default is present" \
        grep -qx 'GSK_RENDERER=gl' /usr/lib/environment.d/50-gsk-renderer.conf
    chk "Goodix fingerprint TOD driver is installed" \
        rpm -q libfprint-tod-goodix
    chk "os-release identifies the image as topaz-os" \
        bash -c 'grep -q "^NAME=\"topaz-os\"" /usr/lib/os-release &&
                 grep -q "^PRETTY_NAME=\"topaz-os " /usr/lib/os-release'
    chk "COSMIC session is available" \
        test -f /usr/share/wayland-sessions/cosmic.desktop
    chk "GDM remains the display manager" \
        bash -c '[ "$(basename "$(readlink /etc/systemd/system/display-manager.service)")" = gdm.service ]'
    chk "night-shift units are present" \
        test -f /usr/lib/systemd/user/topaz-nightshift.timer
    chk "no unprivileged DDC/CI i2c access (COSMIC freeze mitigation)" \
        test ! -e /usr/lib/udev/rules.d/60-ddcutil-i2c.rules
    chk "fingerprint PAM timeout is 5s" \
        grep -q 'pam_fprintd.so timeout=5' /etc/pam.d/system-auth
    chk "authselect profile symlinks to the base profile" \
        test -L /etc/authselect/custom/local-custom/password-auth
    chk "Playwright Chrome path rule is present" \
        test -f /usr/lib/tmpfiles.d/topaz-chrome-path.conf
    chk "supergfxd is enabled" \
        bash -c 'ls /etc/systemd/system/*.wants/supergfxd.service >/dev/null 2>&1'
    chk "speech-dispatcher user preset is present" \
        grep -q 'enable speech-dispatcher.socket' /usr/lib/systemd/user-preset/45-topaz.preset
    chk "topaz ujust recipes are present" \
        test -f /usr/share/ublue-os/just/60-custom.just
    chk "ledger entries are well-formed" \
        bash -c 'for f in "'"$LEDGER_DIR"'"/*.md; do
                     grep -q "^title:" "$f" && grep -q "^paths:" "$f" || exit 1
                 done'
    echo
    if [ "$fails" -eq 0 ]; then
        echo "All recorded deviations hold."
    else
        echo "$fails check(s) failed — the image no longer matches its ledger."
        exit 1
    fi
}

cmd_report() {
    local latest
    latest=$(ls -1 "$STATE_DIR/reports"/*.md 2>/dev/null | tail -1 || true)
    if [ -z "$latest" ]; then
        echo "No night-shift reports yet."
        echo "Enable the night shift with: topaz nightshift enable"
        exit 1
    fi
    echo "== $(basename "$latest") =="
    cat "$latest"
}

cmd_nightshift() {
    case "${1:-status}" in
    enable)
        systemctl --user enable --now topaz-nightshift.timer
        echo "Night shift enabled. Reports will appear in $STATE_DIR/reports/"
        if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/topaz/nightshift.conf" ]; then
            echo
            echo "No triage command configured — reports will be raw event digests."
            echo "To plug in an analysis tool, copy and edit:"
            echo "  /usr/share/topaz-os/nightshift.conf.example -> ~/.config/topaz/nightshift.conf"
        fi
        ;;
    disable)
        systemctl --user disable --now topaz-nightshift.timer
        echo "Night shift disabled."
        ;;
    run)
        exec /usr/libexec/topaz-nightshift
        ;;
    status)
        systemctl --user status topaz-nightshift.timer --no-pager || true
        ;;
    *)
        echo "Usage: topaz nightshift [enable|disable|run|status]"
        exit 1
        ;;
    esac
}

case "${1:-}" in
    why)        [ $# -ge 2 ] || usage 1; cmd_why "$2" ;;
    ledger)     cmd_ledger ;;
    check)      cmd_check ;;
    report)     cmd_report ;;
    nightshift) shift; cmd_nightshift "$@" ;;
    -h|--help|"") usage ;;
    *) usage 1 ;;
esac
