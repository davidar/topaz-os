#!/bin/bash
# topaz — the topaz-os system companion.
#
#   topaz why <path>     Why does this file deviate from the base image?
#   topaz ledger         List all recorded deviations
#   topaz check          Verify the image's recorded deviations actually hold
#   topaz report         Show the most recent night-shift report
#   topaz nightshift ... Manage the night-shift triage timer
#   topaz dev ...        Transient /usr overlay for locally built binaries
set -euo pipefail

LEDGER_DIR="${TOPAZ_LEDGER_DIR:-/usr/share/topaz-os/ledger}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/topaz"
DEV_MANIFEST=/run/topaz-dev/manifest

usage() {
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

strip_frontmatter() {
    awk 'BEGIN{fm=0} /^---$/{fm++; next} fm!=1{print}' "$1"
}

entry_title() {
    awk -F': *' '/^title:/{print $2; exit}' "$1"
}

cmd_ledger() {
    local f
    for f in "$LEDGER_DIR"/*.md; do
        [ -e "$f" ] || { echo "No ledger entries found in $LEDGER_DIR"; exit 1; }
        printf '%s  %s\n' "$(basename "$f" .md)" "$(entry_title "$f")"
    done
}

cmd_why() {
    local query="${1%/}" f found=0
    for f in "$LEDGER_DIR"/*.md; do
        [ -e "$f" ] || break
        if awk -v q="$query" '
            BEGIN{fm=0; hit=1}
            /^---$/{fm++; next}
            fm==1 && /^  - /{sub(/^  - /,""); if ($0==q) {hit=0; exit}}
            END{exit hit}
            ' "$f"; then
            found=1
            strip_frontmatter "$f"
            echo
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "No ledger entry covers '$query'."
        echo "It likely comes from the base image (see: https://docs.projectbluefin.io/)"
        echo "or was changed locally on this machine outside the image."
        exit 1
    fi
}

# --- checks: each recorded deviation must actually hold on this system ------

fails=0
chk() { # chk <description> <command...>
    local desc="$1"; shift
    if "$@" >/dev/null 2>&1; then
        printf '[ ok ] %s\n' "$desc"
    else
        printf '[FAIL] %s\n' "$desc"
        fails=$((fails + 1))
    fi
}

cmd_check() {
    chk "earlyoom is enabled" \
        test -L /etc/systemd/system/multi-user.target.wants/earlyoom.service
    chk "earlyoom config has swap threshold (-s 50)" \
        grep -q -- '-s 50' /etc/default/earlyoom
    chk "earlyoom avoid list shields the COSMIC session" \
        grep -q 'cosmic-comp' /etc/default/earlyoom
    chk "GTK4 GL renderer default is present" \
        grep -qx 'GSK_RENDERER=gl' /usr/lib/environment.d/50-gsk-renderer.conf
    chk "Goodix fingerprint TOD driver is installed" \
        rpm -q libfprint-tod-goodix
    chk "os-release identifies the image as topaz-os" \
        bash -c 'grep -q "^NAME=\"topaz-os\"" /usr/lib/os-release &&
                 grep -q "^PRETTY_NAME=\"topaz-os " /usr/lib/os-release'
    chk "COSMIC session is available" \
        test -f /usr/share/wayland-sessions/cosmic.desktop
    chk "cosmic-comp is the topaz fork build" \
        bash -c 'test -f /usr/share/topaz-os/cosmic-comp-fork &&
                 rpm -Vf /usr/bin/cosmic-comp | grep cosmic-comp | grep -q 5'
    chk "packaged cosmic-comp still matches the fork base version" \
        bash -c '[ "$(rpm -q --qf %{VERSION} cosmic-comp)" = \
                   "$(sed -n "s/^base=//p" /usr/share/topaz-os/cosmic-comp-fork)" ]'
    chk "fork cosmic-comp is loadable (builder glibc matches the image)" \
        bash -c '! ldd /usr/bin/cosmic-comp | grep -q "not found"'
    chk "GDM remains the display manager" \
        bash -c '[ "$(basename "$(readlink /etc/systemd/system/display-manager.service)")" = gdm.service ]'
    chk "night-shift units are present" \
        test -f /usr/lib/systemd/user/topaz-nightshift.timer
    chk "no unprivileged DDC/CI i2c access (COSMIC freeze mitigation)" \
        bash -c '! grep -h i2c /usr/lib/udev/rules.d/*.rules | grep -v "^#" | grep -q uaccess'
    chk "eDP Panel Self Refresh is disabled (DMUB wedge mitigation)" \
        grep -q 'amdgpu.dcdebugmask=0x10' /usr/lib/bootc/kargs.d/10-topaz-display.toml
    chk "fingerprint PAM timeout is 5s" \
        grep -q 'pam_fprintd.so timeout=5' /etc/pam.d/system-auth
    chk "cosmic-greeter may verify fingerprints (lock-screen polkit rule)" \
        bash -c 'grep -q "net.reactivated.fprint.device.verify" \
                     /usr/share/polkit-1/rules.d/60-topaz-cosmic-greeter-fprintd.rules &&
                 grep -q "/usr/bin/cosmic-greeter" \
                     /usr/share/polkit-1/rules.d/60-topaz-cosmic-greeter-fprintd.rules'
    chk "authselect profile symlinks to the base profile" \
        test -L /etc/authselect/custom/local-custom/password-auth
    chk "Playwright Chrome path rule is present" \
        test -f /usr/lib/tmpfiles.d/topaz-chrome-path.conf
    chk "supergfxd is enabled" \
        bash -c 'ls /etc/systemd/system/*.wants/supergfxd.service >/dev/null 2>&1'
    chk "speech-dispatcher user preset is present" \
        grep -q 'enable speech-dispatcher.socket' /usr/lib/systemd/user-preset/45-topaz.preset
    chk "topaz ujust recipes are present" \
        bash -c 'test -f /usr/share/ublue-os/just/60-custom.just &&
                 grep -q "^topaz-touchpad-dwt" \
                     /usr/share/ublue-os/just/60-custom.just'
    # the zone dir is root-only readable, so unprivileged runs (nightshift)
    # verify the packages and skip the zone-file grep; the build gate runs
    # as root and asserts all of it
    chk "KDE Connect is installed with SMS app and firewall service" \
        bash -c 'rpm -q kde-connect >/dev/null &&
                 test -x /usr/bin/kdeconnect-sms &&
                 { [ ! -r /etc/firewalld/zones/FedoraWorkstation.xml ] ||
                   grep -q "service name=\"kdeconnect\"" \
                       /etc/firewalld/zones/FedoraWorkstation.xml; }'
    chk "user-setup recipe helpers are present and valid" \
        bash -c 'test -f /usr/lib/systemd/user/tailscale-systray.service &&
                 test -f /usr/lib/systemd/user/topaz-dropbox.service &&
                 test -f /usr/lib/systemd/user/topaz-bluefin-wallpaper.timer &&
                 test -f /usr/lib/systemd/user/topaz-bluefin-wallpaper.service &&
                 test -x /usr/libexec/topaz-dropbox-icons &&
                 test -x /usr/bin/topaz-bluefin-wallpaper &&
                 test -x /usr/bin/topaz-claude-desktop-update &&
                 bash -n /usr/libexec/topaz-dropbox-icons &&
                 bash -n /usr/bin/topaz-bluefin-wallpaper &&
                 bash -n /usr/bin/topaz-claude-desktop-update'
    chk "ledger entries are well-formed" \
        bash -c 'for f in "'"$LEDGER_DIR"'"/*.md; do
                     grep -q "^title:" "$f" && grep -q "^paths:" "$f" || exit 1
                 done'
    chk "bootc is available for dev overlays" \
        command -v bootc
    chk "package install metadata is reproducible" \
        bash -c 'sde=$(cat /usr/share/topaz-os/source-date-epoch) &&
                 for p in cosmic-session earlyoom kde-connect; do
                     t=$(rpm -q --qf "%{INSTALLTIME}" "$p")
                     [ $((t - sde)) -ge 0 ] && [ $((t - sde)) -lt 1000 ] || exit 1
                 done'
    chk "rpm database is readable from read-only /usr (DELETE journal mode)" \
        bash -c '[ "$(od -A n -j 18 -N 2 -t u1 /usr/share/rpm/rpmdb.sqlite |
                      tr -s " ")" = " 1 1" ]'
    chk "no build-time authselect backup is baked into the image" \
        bash -c '! ls /usr/lib/authselect/backups/ 2>/dev/null | grep -q .'
    chk "sgml catalogs are in canonical order" \
        bash -c 'for f in /etc/sgml/catalog /etc/sgml/*.cat; do
                     [ -L "$f" ] && continue
                     LC_ALL=C sort -C "$f" || exit 1
                 done'
    chk "plugdev group is declared for base-image udev rules" \
        grep -q '^g plugdev' /usr/lib/sysusers.d/topaz-plugdev.conf
    # Runtime-only: on a booted system, machine /etc shadows the image's
    # /usr/etc defaults, so a stale local copy can silently mask an updated
    # image config (found the hard way when an old /etc/default/earlyoom hid
    # the avoid-list shielding the compositor). Files listed here are ones
    # the image ships deliberately and where local divergence is drift, not
    # configuration; content-level assertions above still cover the rest.
    if [ -e /run/ostree-booted ]; then
        chk "machine /etc matches image defaults for ledgered configs" \
            bash -c 'for f in /etc/default/earlyoom; do
                         [ -e "/usr$f" ] || continue
                         cmp -s "$f" "/usr$f" || exit 1
                     done'
    fi
    if overlay_active; then
        echo
        echo "[DEV ] A transient /usr overlay is ACTIVE — this system currently"
        echo "[DEV ] deviates from the signed image. 'topaz dev status' lists the"
        echo "[DEV ] installed binaries; a reboot returns to the image."
    fi
    echo
    if [ "$fails" -eq 0 ]; then
        echo "All recorded deviations hold."
    else
        echo "$fails check(s) failed — the image no longer matches its ledger."
        exit 1
    fi
}

# --- dev: transient /usr overlay for daily-driving locally built binaries ---
# The image is the signed trunk; experiments live in a bootc usroverlay that
# a reboot fully discards. Installed files are recorded in a tmpfs manifest
# so the deviation is always visible (topaz dev status, topaz check).

overlay_active() {
    findmnt -n /usr >/dev/null 2>&1
}

cmd_dev() {
    case "${1:-status}" in
    on)
        if overlay_active; then
            echo "Transient /usr overlay is already active."
        else
            echo "Arming a transient overlay on /usr (bootc usroverlay)."
            echo "Changes under /usr persist until reboot, then vanish."
            pkexec bootc usroverlay
        fi
        ;;
    install)
        [ $# -ge 2 ] || { echo "Usage: topaz dev install <file> [dest]"; exit 1; }
        local src dest sum
        src=$(realpath "$2")
        dest="${3:-/usr/bin/$(basename "$src")}"
        [ -f "$src" ] || { echo "No such file: $src"; exit 1; }
        overlay_active || { echo "No overlay active — run 'topaz dev on' first."; exit 1; }
        sum=$(sha256sum "$src" | cut -d' ' -f1)
        pkexec bash -c "install -m0755 '$src' '$dest' &&
                        mkdir -p /run/topaz-dev &&
                        printf '%s\t%s\t%s\t%s\n' '$dest' '$sum' '$src' \"\$(date -Is)\" \
                            >> $DEV_MANIFEST"
        echo "Installed $dest (sha256 ${sum:0:12}…, gone after reboot)."
        if pgrep -x "$(basename "$dest")" >/dev/null 2>&1; then
            echo "Note: $(basename "$dest") is currently running the old binary;"
            echo "restart it (or the session) to pick up the new one."
        fi
        ;;
    status)
        if overlay_active; then
            echo "Transient /usr overlay: ACTIVE (reboot returns to the signed image)"
            if [ -s "$DEV_MANIFEST" ]; then
                echo "Installed dev binaries:"
                awk -F'\t' '{printf "  %s  %.12s…  from %s  (%s)\n", $1, $2, $3, $4}' \
                    "$DEV_MANIFEST"
            else
                echo "No dev binaries recorded (manifest empty)."
            fi
        else
            echo "Transient /usr overlay: not active — /usr matches the signed image."
        fi
        ;;
    off)
        if overlay_active; then
            echo "The overlay is transient: reboot to return to the signed image."
        else
            echo "No overlay active."
        fi
        ;;
    *)
        echo "Usage: topaz dev [on|install <file> [dest]|status|off]"
        exit 1
        ;;
    esac
}

cmd_report() {
    local latest
    latest=$(ls -1 "$STATE_DIR/reports"/*.md 2>/dev/null | tail -1 || true)
    if [ -z "$latest" ]; then
        echo "No night-shift reports yet."
        echo "Enable the night shift with: topaz nightshift enable"
        exit 1
    fi
    echo "== $(basename "$latest") =="
    cat "$latest"
}

cmd_nightshift() {
    case "${1:-status}" in
    enable)
        systemctl --user enable --now topaz-nightshift.timer
        echo "Night shift enabled. Reports will appear in $STATE_DIR/reports/"
        if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/topaz/nightshift.conf" ]; then
            echo
            echo "No triage command configured — reports will be raw event digests."
            echo "To plug in an analysis tool, copy and edit:"
            echo "  /usr/share/topaz-os/nightshift.conf.example -> ~/.config/topaz/nightshift.conf"
        fi
        ;;
    disable)
        systemctl --user disable --now topaz-nightshift.timer
        echo "Night shift disabled."
        ;;
    run)
        exec /usr/libexec/topaz-nightshift
        ;;
    status)
        systemctl --user status topaz-nightshift.timer --no-pager || true
        ;;
    *)
        echo "Usage: topaz nightshift [enable|disable|run|status]"
        exit 1
        ;;
    esac
}

case "${1:-}" in
    why)        [ $# -ge 2 ] || usage 1; cmd_why "$2" ;;
    ledger)     cmd_ledger ;;
    check)      cmd_check ;;
    report)     cmd_report ;;
    nightshift) shift; cmd_nightshift "$@" ;;
    dev)        shift; cmd_dev "$@" ;;
    -h|--help|"") usage ;;
    *) usage 1 ;;
esac
