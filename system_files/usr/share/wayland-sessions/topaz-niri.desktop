[Desktop Entry]
Name=niri (topaz)
Comment=niri's own systemd session with the COSMIC panel as its bar
Exec=/usr/bin/niri-session
Type=Application
# cosmic-greeter sets XDG_SESSION_DESKTOP from the first name; the session's
# units are gated on it (niri --session itself resets XDG_CURRENT_DESKTOP
# to niri, which keeps the niri portal routing).
DesktopNames=topaz;niri
