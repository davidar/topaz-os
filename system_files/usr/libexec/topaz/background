#!/bin/bash
# topaz-background.service's ExecStart (ledger 0048): paint the wallpaper
# the base image gives GNOME, on the schedule GNOME follows.
#
# Bluefin pins one of its month-named timed wallpapers in a gschema
# override at base-build time (picture-uri-dark); GNOME reads that XML
# and cross-fades day/night on its clock. swaybg knows nothing about
# timed wallpapers, so this script reads the same override, walks the
# same XML, and runs swaybg with whichever image the schedule names
# now, restarting it at the next change (a transition counts as its
# midpoint: the first half shows the old image, the second the new).
# No per-user state: new artwork arrives with the base image, exactly as
# it does for GNOME.
#
# Knobs (~/.config/topaz/session.conf, the unit's EnvironmentFile):
#   TOPAZ_WALLPAPER  an image, or a GNOME timed-wallpaper XML, in place
#                    of the base image's choice.
# With --print the chosen image and the seconds until the next change
# are printed instead of running swaybg — the build-time check reads
# it, with TOPAZ_BACKGROUND_NOW (seconds since the epoch) standing in
# for the clock.
set -eu

override=/usr/share/glib-2.0/schemas/zz0-bluefin-modifications.gschema.override
fallback=/usr/share/backgrounds/bluefin/01-bluefin-night.jxl

source=${TOPAZ_WALLPAPER:-}
if [ -z "$source" ]; then
    source=$(sed -n "s|^picture-uri-dark='file://\(.*\)'$|\1|p" "$override" 2>/dev/null | head -1)
fi
if [ -z "$source" ] || [ ! -e "$source" ]; then
    echo "topaz-background: no wallpaper at '${source:-(unset)}'; using $fallback" >&2
    source=$fallback
fi

# Read a GNOME timed-wallpaper XML into parallel arrays of (image,
# seconds). A <transition> becomes two half-length segments, one per
# image. The cycle starts at <starttime>'s time of day; the date part is
# ignored, as GNOME effectively does for a 24-hour cycle.
files=()
durs=()
start_of_cycle=0
read_schedule() {
    local xml=$1 count i kind file dur from to half
    local h m s
    h=$(xmllint --xpath 'string(/background/starttime/hour)' "$xml")
    m=$(xmllint --xpath 'string(/background/starttime/minute)' "$xml")
    s=$(xmllint --xpath 'string(/background/starttime/second)' "$xml")
    start_of_cycle=$(( ${h:-0} * 3600 + ${m:-0} * 60 + ${s:-0} ))
    count=$(xmllint --xpath 'count(/background/*)' "$xml")
    for ((i = 1; i <= count; i++)); do
        kind=$(xmllint --xpath "name(/background/*[$i])" "$xml")
        case "$kind" in
        static)
            file=$(xmllint --xpath "string(/background/*[$i]/file)" "$xml")
            dur=$(xmllint --xpath "string(/background/*[$i]/duration)" "$xml")
            files+=("$file"); durs+=("${dur%.*}")
            ;;
        transition)
            from=$(xmllint --xpath "string(/background/*[$i]/from)" "$xml")
            to=$(xmllint --xpath "string(/background/*[$i]/to)" "$xml")
            dur=$(xmllint --xpath "string(/background/*[$i]/duration)" "$xml")
            half=$(( ${dur%.*} / 2 ))
            files+=("$from"); durs+=("$half")
            files+=("$to"); durs+=("$(( ${dur%.*} - half ))")
            ;;
        esac
    done
    [ ${#files[@]} -gt 0 ]
}

# Resolve the schedule at $1 (epoch seconds): sets `image` and `remaining`
# (seconds until the image changes, merging consecutive segments that
# name the same file).
image=
remaining=0
resolve() {
    local now=$1 midnight offset total=0 i end=0 n=${#files[@]} j
    midnight=$(date -d "$(date -d "@$now" +%F) 00:00:00" +%s)
    for d in "${durs[@]}"; do total=$((total + d)); done
    offset=$(( (now - midnight - start_of_cycle) % total ))
    ((offset < 0)) && offset=$((offset + total))
    for ((i = 0; i < n; i++)); do
        end=$((end + durs[i]))
        if ((offset < end)); then
            image=${files[i]}
            remaining=$((end - offset))
            j=$(( (i + 1) % n ))
            while ((j != i)) && [ "${files[j]}" = "$image" ]; do
                remaining=$((remaining + durs[j]))
                j=$(( (j + 1) % n ))
            done
            return
        fi
    done
}

paint() {  # <image>: swaybg in the background, pid in $swaybg
    swaybg -m fill -i "$1" &
    swaybg=$!
}

case "$source" in
*.xml)
    read_schedule "$source" || { echo "topaz-background: $source has no schedule" >&2; exit 1; }
    if [ "${1:-}" = --print ]; then
        resolve "${TOPAZ_BACKGROUND_NOW:-$(date +%s)}"
        printf '%s\n%s\n' "$image" "$remaining"
        exit 0
    fi
    swaybg=
    trap 'kill "$swaybg" 2>/dev/null; exit 0' TERM INT
    while true; do
        resolve "$(date +%s)"
        paint "$image"
        # A backgrounded sleep keeps the loop interruptible: a stop
        # request reaches the trap at once instead of after the sleep.
        sleep "$remaining" & wait $! || true
        kill "$swaybg" 2>/dev/null; wait "$swaybg" 2>/dev/null || true
    done
    ;;
*)
    if [ "${1:-}" = --print ]; then
        printf '%s\n0\n' "$source"
        exit 0
    fi
    exec swaybg -m fill -i "$source"
    ;;
esac
