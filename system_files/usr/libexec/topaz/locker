#!/bin/bash
# topaz-locker.service's ExecStart (ledger 0041): swaylock, with the moment
# the compositor confirms the session lock forwarded to systemd as the
# unit's readiness. swaylock writes one line to --ready-fd at that moment;
# with Type=notify, `systemctl --user start topaz-locker.service` returns
# only then, so swayidle's before-sleep holds the suspend until the screen
# is locked rather than until a lock has merely been asked for.
set -eu

fifo=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/topaz-locker.XXXXXX")
mkfifo -m 0600 "$fifo"
exec 3<> "$fifo"
rm -f "$fifo"

/usr/bin/swaylock --ready-fd 3 &
swaylock=$!

if read -r -t 20 _ <&3; then
    systemd-notify --ready
else
    echo "swaylock reported no lock within 20 s" >&2
fi
exec 3<&-

# Live as long as the lock does; swaylock's exit status is the unit's.
wait "$swaylock"
