[Unit]
Description=Clipboard history (cliphist) for the niri (topaz) session
ConditionEnvironment=XDG_SESSION_DESKTOP=topaz
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/wl-paste --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
