[Unit]
Description=Screen locker (cosmic-greeter, ext-session-lock) for the niri (topaz) session
# Inside a session cosmic-greeter runs as the locker: it takes the logind
# Lock signal and ext-session-lock. The topaz fork exits non-zero after an
# abandoned lock so that a supervisor restarts it (ledger 0034) — that is
# Restart=on-failure here, as it was under cosmic-session.
ConditionEnvironment=XDG_SESSION_DESKTOP=topaz
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/cosmic-greeter
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
