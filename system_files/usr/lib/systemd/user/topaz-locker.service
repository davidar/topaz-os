[Unit]
Description=Screen locker (swaylock, ext-session-lock) for the niri (topaz) session
# The rescue locker. The session locks through the canvas's lock sidecar
# (ledger 0049); nothing starts this unit. It stays for the case where
# that sidecar is taken out of the canvas's list again (a drop-in on
# caustics-canvas.service): a drop-in on topaz-idle.service then runs
# swayidle with `lock` and `before-sleep` set to `systemctl --user start
# topaz-locker.service`, as the session did before the canvas. swaylock
# takes the session lock and exits once the password is accepted, so the
# unit is active exactly while the screen is locked. The ExecStart wrapper
# turns swaylock's "lock held" notification into the unit's readiness
# (Type=notify), so a `systemctl start` returns once the screen is
# actually locked: a before-sleep hold waits exactly that long. A locker
# that dies while locked leaves the compositor locked with no client to
# unlock it, hence Restart=on-failure. No [Install] section.
ConditionEnvironment=XDG_SESSION_DESKTOP=topaz
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/libexec/topaz/locker
# The canvas learns of a lock only from its own sidecar: a dim that
# reached its depth would stay up behind swaylock and greet the unlock
# with a dissolved desktop. Undim once swaylock holds the lock; `-` so a
# canvas that is away never fails the locker.
ExecStartPost=-caustics-canvasctl undim
TimeoutStartSec=25
Restart=on-failure
RestartSec=1
