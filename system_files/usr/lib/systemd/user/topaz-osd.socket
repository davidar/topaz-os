[Unit]
Description=On-screen display pipe (wob) for the niri (topaz) session
# topaz-osd writes a percentage here; the first write starts wob.
ConditionEnvironment=XDG_SESSION_DESKTOP=topaz
PartOf=graphical-session.target
After=graphical-session.target

[Socket]
ListenFIFO=%t/topaz-osd.sock
SocketMode=0600
RemoveOnStop=on
FlushPending=yes

[Install]
WantedBy=graphical-session.target
