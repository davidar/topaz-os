# topaz-os: GPU mode switching daemon on by default (hybrid laptops)
enable supergfxd.service

# topaz-os: stage updates via parallel partial pulls ahead of uupd
enable topaz-pull.timer

# topaz-os: greetd with tuigreet is the display manager
disable gdm.service
enable greetd.service

# topaz-os: kernel messages on the console during boot and shutdown only
enable topaz-console-loglevel.service

# topaz-os: other operating systems in the GRUB menu
enable topaz-grub-entries.service

# topaz-os: disk swapfile behind zswap
enable var-swap-swapfile.swap
