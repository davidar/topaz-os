# topaz-os: GPU mode switching daemon on by default (hybrid laptops)
enable supergfxd.service

# topaz-os: stage updates via parallel partial pulls ahead of uupd
# (ledger 0032)
enable topaz-pull.timer

# topaz-os: greetd with tuigreet is the display manager (ledger 0045)
disable gdm.service
enable greetd.service

# topaz-os: disk swapfile behind zswap (ledger 0042)
enable var-swap-swapfile.swap
