[Unit]
Description=Stage OS updates with parallel partial pulls (topaz pull)
Documentation=file:///usr/share/topaz-os/ledger/0032-topaz-pull-timer.md
Wants=network-online.target
After=network-online.target
# If a boot catch-up queues this together with uupd (both timers are
# Persistent), stage the update first so uupd's bootc step no-ops.
Before=uupd.service
# The Persistent timer fires the 03:30 run at the next resume, seconds
# before wifi is back; network-online.target was reached at boot and
# does not re-gate on resume. Retry a few times, then stay failed so a
# real outage remains visible.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/bin/topaz pull
Restart=on-failure
RestartSec=2min
