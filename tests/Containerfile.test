# Derived VM-test image — never published. Adds only what the harness
# needs to drive the image unattended: a greetd initial_session (autologin
# into the chosen session on the first boot; later logins go through
# tuigreet as shipped), sshd as the assertion channel, and passwordless
# sudo for the tester.
ARG BASE=localhost/topaz-os:test
FROM $BASE
# Which session the autologin runs: topaz-niri is the only one today.
ARG TOPAZ_TEST_SESSION=topaz-niri

# One RUN, one layer: on the CI runner each step's commit over the
# ~400-layer chunked base costs ~5 minutes, so the COPYs ride the same
# layer via a bind-mounted context instead of steps of their own.
# The tester user itself is injected at disk-build time (disk-test.toml),
# not here — the image layer ships no users and /var stays empty.
#
# A companion repo's payload rides the same layer: lib.sh passes the
# directory named by TOPAZ_TEST_EXTRA as the `extra` build context (an empty
# one when unset), and its install.sh is run as root from inside it — a
# non-empty context without one fails the build rather than baking nothing.
# `z` relabels both mounts for SELinux: a context outside the one
# directory podman labelled for the build (an additional one, or this
# repository checked out as a second worktree) is otherwise unreadable
# here and looks empty. Without an extra context this is exactly the
# image it was.
RUN --mount=type=bind,source=files,target=/run/test-files,z \
    --mount=type=bind,from=extra,target=/run/test-extra,z \
    install -m 0755 /run/test-files/topaz-test-session /usr/bin/topaz-test-session && \
    # The shipped greetd config (ledger 0045) plus an initial_session, so
    # the first boot lands in the session under test with no one at the
    # console; the grep proves the shipped half is the one being extended.
    grep -q '^command = "tuigreet ' /etc/greetd/config.toml && \
    printf '\n[initial_session]\ncommand = "/usr/bin/topaz-test-session"\nuser = "tester"\n' \
        >> /etc/greetd/config.toml && \
    mkdir -p /etc/topaz && echo "$TOPAZ_TEST_SESSION" > /etc/topaz/test-session && \
    systemctl enable sshd.service && \
    # niri's first-launch "Important Hotkeys" overlay would sit over
    # every screendump; uncomment the baked config's opt-out. The grep
    # proves the edit landed (and fails loudly if the config drifts).
    sed -i 's|^\( *\)// skip-at-startup$|\1skip-at-startup|' /etc/niri/config.kdl && \
    grep -q '^ *skip-at-startup$' /etc/niri/config.kdl && \
    echo 'tester ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/50-topaz-test && \
    chmod 0440 /etc/sudoers.d/50-topaz-test && \
    if [ -n "$(ls -A /run/test-extra)" ]; then \
        (cd /run/test-extra && ./install.sh); \
    fi
