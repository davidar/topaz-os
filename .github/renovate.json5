{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "customManagers": [
    {
      // The chunkah tool pin in the chunk step (ledger 0028). Tracks the
      // published :latest digest — chunkah documents its bootc rechunking
      // support on main, ahead of tagged releases.
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/chunk-image\\.sh$/"],
      "matchStrings": [
        "chunkah_image=\"(?<depName>[^:@\\s\"]+):(?<currentValue>[^@\\s\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"",
      ],
      "datasourceTemplate": "docker",
    },
    {
      // The released-skopeo image used for the registry push (the
      // runner's baked skopeo is a git dev build — see build.yml).
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/build\\.yml$/"],
      "matchStrings": [
        "skopeo_image=\"(?<depName>[^:@\\s\"]+):(?<currentValue>[^@\\s\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"",
      ],
      "datasourceTemplate": "docker",
    },
  ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      // The base image digest is owned by .github/workflows/refresh-inputs.yml,
      // which bumps it together with the package lockfile it invalidates
      // (ledger 0022): the two must move atomically, and Renovate cannot
      // regenerate rpm lockfiles.
      "enabled": false,
      "matchPackageNames": ["ghcr.io/ublue-os/bluefin-dx-nvidia-open"],
      "matchUpdateTypes": ["digest"],
    },
    {
      // cosign v3 signs with the new Sigstore bundle format, which podman,
      // skopeo, and rpm-ostree cannot verify yet. Stay on v2 until
      // https://github.com/containers/container-libs/issues/388 is resolved,
      // then delete this rule.
      "enabled": false,
      "matchPackageNames": ["sigstore/cosign"],
      "matchUpdateTypes": ["major"],
    },
    {
      // The comp-build builder must stay on the same Fedora release as the
      // base image: a newer builder links cosmic-comp against a newer glibc
      // than the image ships and the compositor fails to load at login.
      // Bump this manually whenever the base image moves to a new release.
      "enabled": false,
      "matchPackageNames": ["registry.fedoraproject.org/fedora"],
      "matchUpdateTypes": ["major"],
    },
  ]
}
