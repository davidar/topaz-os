+/// The toplevels announced by `zwlr_foreign_toplevel_manager_v1`, in
+/// announcement order.
+///
+/// Used to act on toplevels when the compositor is not cosmic-comp and so does
+/// not offer `zcosmic_toplevel_manager_v1`.
+struct WlrToplevelState {
+    toplevels: Vec<WlrToplevel>,
+}
+
+struct WlrToplevel {
+    handle: ZwlrForeignToplevelHandleV1,
+    app_id: String,
+    title: String,
+}
+
+impl WlrToplevelState {
+    /// Binds `zwlr_foreign_toplevel_manager_v1`, if the compositor offers it.
+    ///
+    /// The manager proxy is not retained; its only use is to announce
+    /// toplevels, which are dispatched through the connection.
+    fn bind<D>(registry: &RegistryState, qh: &QueueHandle<D>) -> Option<Self>
+    where
+        D: Dispatch<ZwlrForeignToplevelManagerV1, ()> + 'static,
+    {
+        registry
+            .bind_one::<ZwlrForeignToplevelManagerV1, D, _>(qh, 1..=3, ())
+            .ok()?;
+        Some(Self {
+            toplevels: Vec::new(),
+        })
+    }
+}
+
+impl Dispatch<ZwlrForeignToplevelManagerV1, ()> for AppData {
+    fn event(
+        state: &mut Self,
+        _: &ZwlrForeignToplevelManagerV1,
+        event: zwlr_foreign_toplevel_manager_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let Some(wlr_toplevel_state) = state.wlr_toplevel_state.as_mut() else {
+            return;
+        };
+        match event {
+            zwlr_foreign_toplevel_manager_v1::Event::Toplevel { toplevel } => {
+                wlr_toplevel_state.toplevels.push(WlrToplevel {
+                    handle: toplevel,
+                    app_id: String::new(),
+                    title: String::new(),
+                });
+            }
+            zwlr_foreign_toplevel_manager_v1::Event::Finished => {
+                state.wlr_toplevel_state = None;
+            }
+            _ => {}
+        }
+    }
+
+    cctk::wayland_client::event_created_child!(AppData, ZwlrForeignToplevelManagerV1, [
+        zwlr_foreign_toplevel_manager_v1::EVT_TOPLEVEL_OPCODE => (ZwlrForeignToplevelHandleV1, ())
+    ]);
+}
+
+impl Dispatch<ZwlrForeignToplevelHandleV1, ()> for AppData {
+    fn event(
+        state: &mut Self,
+        handle: &ZwlrForeignToplevelHandleV1,
+        event: zwlr_foreign_toplevel_handle_v1::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let Some(wlr_toplevel_state) = state.wlr_toplevel_state.as_mut() else {
+            return;
+        };
+        match event {
+            zwlr_foreign_toplevel_handle_v1::Event::Title { title } => {
+                if let Some(toplevel) = wlr_toplevel_state
+                    .toplevels
+                    .iter_mut()
+                    .find(|toplevel| &toplevel.handle == handle)
+                {
+                    toplevel.title = title;
+                }
+            }
+            zwlr_foreign_toplevel_handle_v1::Event::AppId { app_id } => {
+                if let Some(toplevel) = wlr_toplevel_state
+                    .toplevels
+                    .iter_mut()
+                    .find(|toplevel| &toplevel.handle == handle)
+                {
+                    toplevel.app_id = app_id;
+                }
+            }
+            zwlr_foreign_toplevel_handle_v1::Event::Closed => {
+                wlr_toplevel_state
+                    .toplevels
+                    .retain(|toplevel| &toplevel.handle != handle);
+            }
+            _ => {}
+        }
+    }
+}
+
 sctk::delegate_seat!(AppData);
 sctk::delegate_registry!(AppData);
 sctk::delegate_shm!(AppData);
